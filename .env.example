DATABASE_URL=postgresql://strowger:strowger@localhost:5432/strowger
REDIS_URL=redis://localhost:6379
# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Engine
ENGINE_PORT=4000
ENGINE_PUBLIC_URL=http://localhost:4000
NEXT_PUBLIC_ENGINE_URL=http://localhost:4000
ENGINE_INTERNAL_KEY=change-me-32-characters-minimum-please
# jambonz (see docs/JAMBONZ-SETUP.md)
JAMBONZ_API_URL=
JAMBONZ_API_KEY=
JAMBONZ_ACCOUNT_SID=
JAMBONZ_APPLICATION_SID=
JAMBONZ_SIP_REALM=
JAMBONZ_WEBHOOK=
JAMBONZ_CARRIER=Telnyx
JAMBONZ_WSS_URL=wss://sip.jambonz.cloud:8443
# Commio (Phase 2)
COMMIO_API_URL=
COMMIO_USERNAME=
COMMIO_TOKEN=
# Crossbar scrub (optional; engine)
CROSSBAR_URL=https://www.crossbar.digital
CROSSBAR_AGENT_KEY=
SCRUB_PAID=true
# SMS (engine): commio | telnyx | log
SMS_PROVIDER=telnyx
COMMIO_API_URL=https://api.thinq.com
COMMIO_ACCOUNT_ID=
WEB_PUBLIC_URL=http://localhost:3000
TELNYX_API_KEY=
# AI read of inbound text replies (engine). Unset = STOP keyword matching only.
ANTHROPIC_API_KEY=
SMS_AI_MODEL=claude-opus-5-5
SMS_AI_OPT_OUT_THRESHOLD=0.8
# Screener detection (engine): STT vendor configured on the jambonz account, e.g. deepgram
SCREENER_STT_VENDOR=
SCREENER_STT_LANGUAGE=en-US
# Inbound SMS webhooks (web)
TELNYX_PUBLIC_KEY=
SMS_WEBHOOK_TOKEN=
# Media bucket (web): S3-compatible; on Railway reference the bucket's variables
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
