{
  "name": "strowger",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @strowger/db generate",
    "db:migrate": "pnpm --filter @strowger/db migrate:dev",
    "db:deploy": "pnpm --filter @strowger/db migrate:deploy",
    "db:seed": "pnpm --filter @strowger/db seed"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
