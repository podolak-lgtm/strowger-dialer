// Strowger data model. Every business table carries tenantId: this is a
// multi-tenant product from the first migration. See docs/PLAN.md §5.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Tenancy & people ─────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  /// Clerk organization id, when the tenant is backed by a Clerk org.
  clerkOrgId String? @unique
  settings  Json     @default("{}")
  /// Recording retention in days (owner, 4 Nov: 30–60 to keep storage cost down).
  recordingRetentionDays Int @default(60)
  /// Nightly batch export of recordings before they expire:
  /// {"type":"sftp","host":"","port":22,"username":"","password":"<enc>","path":"/recordings"}
  /// or {"type":"dropbox","token":"<enc>","path":"/Strowger"}; null = no export.
  recordingExport        Json?
  /// Carrier provisioning (owner, 4 Nov: order and register numbers from Strowger).
  /// Telnyx resources this tenant's numbers are attached to, and the jambonz carrier.
  telnyxConnectionId        String?
  telnyxOutboundProfileId   String?
  telnyxMessagingProfileId  String?
  jambonzCarrierSid         String?
  /// 10DLC (A2P texting registration) at Telnyx: brand and campaign ids plus the last snapshot seen.
  tenDlcBrandId    String?
  tenDlcCampaignId String?
  tenDlcBrand      Json?
  tenDlcCampaign   Json?
  /// The owner's own workspace: sees every client's billing and sets cost rates (one tenant).
  isPlatform       Boolean  @default(false)
  billing          BillingAccount?
  billingEntries   BillingEntry[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  rooms          Room[]
  teams          Team[]
  campaigns      Campaign[]
  lists          List[]
  leads          Lead[]
  affiliates     Affiliate[]
  dncEntries     DncEntry[]
  callerIds      CallerIdNumber[]
  numberOrders   NumberOrder[]
  chatMessages   ChatMessage[]
  wagers         Wager[]
  pointsLedger   PointsLedger[]
  pokerCards     PokerCard[]
  pokerRuns      PokerRun[]
  audioAssets    AudioAsset[]
  calls          Call[]
  messages       Message[]
  webhooks       WebhookEndpoint[]
  auditLogs      AuditLog[]
  agentSessions  AgentSession[]
  callbacks      Callback[]
  leadEvents     LeadEvent[]
  abandonLedger  AbandonLedger[]
  transfers      Transfer[]
  campaignAgents CampaignAgent[]
  dispositions   Disposition[]
  dialPlans      DialPlan[]
  scripts        Script[]
  cadences       CadenceProfile[]
  skills         Skill[]
  ivrs           Ivr[]
  queues         Queue[]
  voicemailBoxes VoicemailBox[]
  voicemails     Voicemail[]
}

enum Role {
  ADMIN
  SUPERVISOR
  ROOM_SUPERVISOR
  TEAM_LEADER
  AGENT
  AFFILIATE
}

model User {
  id          String   @id @default(cuid())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  tenantId    String
  clerkUserId String?  @unique
  email       String
  firstName   String?
  lastName    String?
  roles       Role[]   @default([AGENT])
  /// Agent level 1–8 (owner, 5 Nov): rights per level are tenant settings (`levelRights`).
  level       Int      @default(1)
  /// Where to text the agent (voicemail alerts). E.164 digits.
  mobilePhone String?
  /// Text me when a voicemail lands in my box (also needs the campaign switch).
  notifyVoicemailSms Boolean @default(true)
  /// Game points (bets); topped up weekly from tenant settings.
  points      Int      @default(0)
  active      Boolean  @default(true)
  /// SIP credentials for the browser softphone. The password is stored
  /// encrypted (AES-GCM under a key derived from ENGINE_INTERNAL_KEY): the
  /// registration hook needs it to verify digests and the agent's own browser
  /// needs it to register. Never shown to anyone else.
  sipUsername String?  @unique
  sipSecret   String?
  /// For AFFILIATE-role users: the partner whose lists they may see.
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id])
  affiliateId String?
  /// Short dialable extension (e.g. 101), unique per tenant.
  extension   String?
  skills      AgentSkill[]
  voicemailBoxes VoicemailBox[] @relation("BoxOwner")
  voicemails  Voicemail[]    @relation("VoicemailAssignee")
  routedNumbers CallerIdNumber[] @relation("NumberRouteUser")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms           UserRoom[]
  teams           UserTeam[]
  ledTeams        Team[]          @relation("TeamLeader")
  chatSent        ChatMessage[]   @relation("ChatSender")
  wagersProposed  Wager[]         @relation("WagerProposer")
  wagersAccepted  Wager[]         @relation("WagerAccepter")
  pointsLedger    PointsLedger[]
  pokerCards      PokerCard[]
  pokerRunsStarted PokerRun[]     @relation("PokerRunCreator")
  supervisedRooms Room[]          @relation("RoomSupervisor")
  campaignAgents  CampaignAgent[]
  agentSessions   AgentSession[]
  calls           Call[]
  callbacks       Callback[]
  ownedLeads      Lead[]          @relation("LeadOwner")
  leadEvents      LeadEvent[]
  auditLogs       AuditLog[]
  transfersFrom   Transfer[]      @relation("TransferFrom")
  transfersTo     Transfer[]      @relation("TransferTo")
  messages        Message[]

  @@unique([tenantId, email])
  @@unique([tenantId, extension])
  @@index([tenantId])
}

/// A physical location or floor. Several rooms may work one campaign.
model Room {
  id           String  @id @default(cuid())
  tenant       Tenant  @relation(fields: [tenantId], references: [id])
  tenantId     String
  name         String
  supervisor   User?   @relation("RoomSupervisor", fields: [supervisorId], references: [id])
  supervisorId String?
  members      UserRoom[]
  teams        Team[]

  @@unique([tenantId, name])
}

model UserRoom {
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId String

  @@id([userId, roomId])
}

/// A team leader and the agents under them. A team may sit inside a room.
model Team {
  id       String  @id @default(cuid())
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  tenantId String
  name     String
  leader   User?   @relation("TeamLeader", fields: [leaderId], references: [id])
  leaderId String?
  room     Room?   @relation(fields: [roomId], references: [id])
  roomId   String?
  members  UserTeam[]

  @@unique([tenantId, name])
}

model UserTeam {
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  @@id([userId, teamId])
}

// ───────────────────────────── Campaigns ─────────────────────────────

enum DialMode {
  RATIO
  PREVIEW
}

enum VoicemailAction {
  HANGUP
  DROP
}

enum VoicemailMode {
  FILE
  TTS
}

enum ScreenerAction {
  MESSAGE
  AGENT
  HANGUP
}

enum CallerIdMode {
  FIXED
  LOCAL_PRESENCE
}

enum HopperOrder {
  LIFO
  FIFO
  PRIORITY
}

enum ListSelection {
  STRICT_PRIORITY
  WEIGHTED_ROUND_ROBIN
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

model Campaign {
  id       String         @id @default(cuid())
  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  tenantId String
  name     String
  status   CampaignStatus @default(DRAFT)

  dialMode DialMode @default(PREVIEW)
  /// Lines per ready agent in RATIO mode. The pacing loop never exceeds it.
  ratio    Decimal  @default(1.0) @db.Decimal(4, 2)
  maxRatio Decimal  @default(3.0) @db.Decimal(4, 2)

  /// Abandon cap, rolling 30 days, percent. 3.0 is the FTC safe harbor.
  abandonCapPct  Decimal @default(3.0) @db.Decimal(4, 2)
  /// Ratio starts stepping down when the 30-day rate reaches this.
  abandonWarnPct Decimal @default(2.5) @db.Decimal(4, 2)
  /// A human answer not bridged within this many ms is an abandon.
  abandonTimerMs Int     @default(2000)
  safeHarborAudioId String?

  amdEnabled           Boolean         @default(true)
  voicemailAction      VoicemailAction @default(HANGUP)
  voicemailDropAudioId String?
  /// FILE plays voicemailDropAudioId; TTS speaks voicemailScript with
  /// variables ({{first_name}}, {{last_name}}, {{company}}, {{callback_number}},
  /// {{agent}}). TTS needs a speech vendor on the jambonz account.
  voicemailMode        VoicemailMode   @default(FILE)
  voicemailScript      String?
  /// Minutes before a lead that reached voicemail is tried again.
  voicemailRetryMinutes Int            @default(240)
  /// Text the owning agent when a caller leaves them a voicemail (per-agent switch too).
  voicemailNotifySms Boolean @default(true)
  /// Agent assist: [{"objection":"…","response":"…"}]
  rebuttals          Json?

  screenerDetection Boolean        @default(true)
  screenerAction    ScreenerAction @default(MESSAGE)
  screenerAudioId   String?

  recordingOn       Boolean @default(true)
  disclosureOn      Boolean @default(false)
  disclosureAudioId String?

  callerIdMode  CallerIdMode @default(LOCAL_PRESENCE)
  fixedCallerId String?

  /// Campaign's own calling window in the lead's local time. State and
  /// federal rules still apply on top; the most restrictive wins.
  localWindowStart Int @default(9)
  localWindowEnd   Int @default(20)
  /// Optional day x hour grid in the lead's local time: 7 arrays (Sun..Sat)
  /// of 24 flags. Null = the start/end window applies every day.
  allowedHours     Json?
  /// Campaign default attempts per lead (phone) per day. Dial plans may raise
  /// it, never above the state cap.
  maxAttemptsPerDay Int @default(3)
  wrapUpSeconds     Int @default(30)
  hopperOrder       HopperOrder @default(LIFO)
  /// How lists of different priority tiers share the dialer.
  listSelection     ListSelection @default(STRICT_PRIORITY)

  /// Whether closers may turn outbound on for themselves (plan §11.7).
  closersMayDial Boolean @default(true)
  /// Minutes an agent-scoped callback waits for its owner before it is
  /// offered to the campaign.
  callbackOwnerMinutes Int @default(30)

  /// Games (owner, 5 Nov): switched on per campaign. Bets between agents on
  /// this campaign; the Monday allowance and stake cap apply to its agents.
  /// Defaults for new campaigns come from Tenant.settings.games.
  betsEnabled  Boolean @default(false)
  weeklyPoints Int     @default(10000)
  maxStake     Int     @default(5000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pokerRuns     PokerRun[]
  lists         List[]
  agents        CampaignAgent[]
  dispositions  Disposition[]
  dialPlans     DialPlan[]
  scripts       Script[]
  calls         Call[]
  callbacks     Callback[]
  dncEntries    DncEntry[]
  abandonLedger AbandonLedger[]
  agentSessions AgentSession[]
  messages      Message[]
  webhooks      WebhookEndpoint[]
  callerIds     CallerIdNumber[]
  numberOrders  NumberOrder[]
  queues        Queue[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
}

enum AgentMode {
  FRONTER
  CLOSER
  BOTH
}

model CampaignAgent {
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  tenantId   String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  agentMode  AgentMode @default(BOTH)
  /// For CLOSER mode: outbound currently switched on (the checkbox).
  outboundOn Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@id([campaignId, userId])
  @@index([tenantId, userId])
}

/// How a campaign dials a lead of a given type at a given age. The strategy
/// names an algorithm in the engine; `fixed_gap` is the first. This is the
/// seat of the retry work that is meant to set the product apart.
model DialPlan {
  id             String   @id @default(cuid())
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  tenantId       String
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId     String
  /// Lead bucket this plan applies to; null = any.
  leadType       String?
  ageFromDays    Int      @default(0)
  ageToDays      Int?
  attemptsPerDay Int      @default(3)
  retryGapMinutes Int     @default(180)
  /// Higher weight = earlier in a PRIORITY-ordered hopper.
  weight         Int      @default(0)
  strategy       String   @default("fixed_gap")
  params         Json     @default("{}")
  active         Boolean  @default(true)

  @@index([campaignId, active])
}

model Disposition {
  id                  String   @id @default(cuid())
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  tenantId            String
  campaign            Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId          String
  code                String
  label               String
  hotkey              String?
  isContact           Boolean  @default(false)
  isSale              Boolean  @default(false)
  isDnc               Boolean  @default(false)
  isCallback          Boolean  @default(false)
  /// Null = the lead is finished; otherwise it recycles after this long.
  recycleAfterMinutes Int?
  sortOrder           Int      @default(0)
  active              Boolean  @default(true)

  calls Call[]

  @@unique([campaignId, code])
}

model Script {
  id         String   @id @default(cuid())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  tenantId   String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  version    Int      @default(1)
  body       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([campaignId, version])
}

// ───────────────────────────── Lists & leads ─────────────────────────────

enum ListSource {
  UPLOAD
  POST
}

enum ListStatus {
  IMPORTING
  ACTIVE
  PAUSED
  ARCHIVED
}

enum DuplicateAction {
  REJECT
  ACCEPT
  UPDATE
}

model List {
  id          String     @id @default(cuid())
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  tenantId    String
  campaign    Campaign?  @relation(fields: [campaignId], references: [id])
  campaignId  String?
  name        String
  source      ListSource @default(UPLOAD)
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id])
  affiliateId String?
  status      ListStatus @default(ACTIVE)
  /// What to do with a phone already in this list.
  duplicateAction DuplicateAction @default(REJECT)
  /// 1 = high, 2 = medium, 3 = low. Strict priority dials every eligible
  /// tier-1 lead before any tier-2 lead.
  priority        Int             @default(2)
  cadence         CadenceProfile? @relation(fields: [cadenceProfileId], references: [id])
  cadenceProfileId String?
  /// Counters kept current by the import and posting paths.
  totalLeads    Int @default(0)
  dialableLeads Int @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  leads   Lead[]
  imports ListImport[]

  @@unique([tenantId, name])
  @@index([campaignId, status])
}

enum ImportStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
}

model ListImport {
  id            String       @id @default(cuid())
  list          List         @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId        String
  fileName      String
  storageUrl    String?
  mapping       Json
  status        ImportStatus @default(QUEUED)
  totalRows     Int          @default(0)
  acceptedRows  Int          @default(0)
  duplicateRows Int          @default(0)
  badPhoneRows  Int          @default(0)
  dncRows       Int          @default(0)
  litigatorRows Int          @default(0)
  errorReason   String?
  createdAt     DateTime     @default(now())
  finishedAt    DateTime?
}

enum CadenceKind {
  FRESH
  AGED
}

/// The rules a list dials by: how fast, how often, in which dayparts, and
/// which texts go out around the call. Attached to lists; a campaign's dial
/// plans still apply where a list has no cadence.
model CadenceProfile {
  id       String      @id @default(cuid())
  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  tenantId String
  name     String
  kind     CadenceKind @default(AGED)

  /// FRESH: dial within seconds of the post (when an agent is Ready).
  instantDial         Boolean @default(false)
  /// Seconds between the pre-call text and the dial.
  instantDelaySeconds Int     @default(15)
  /// Text sent from the dialing number just before the call. Null = none.
  preCallSms          String?
  /// Text sent when the call is not answered. Null = none.
  missedCallSms       String?

  maxAttemptsPerDay Int @default(3)
  minGapMinutes     Int @default(240)
  /// AGED: rotate dayparts so consecutive attempts never share a window.
  rotateDayparts    Boolean @default(false)
  /// {"MORNING":[8.5,11.5],"AFTERNOON":[12.5,16.5],"EVENING":[17,19.5]} local hours.
  dayparts          Json    @default("{\"MORNING\":[8.5,11.5],\"AFTERNOON\":[12.5,16.5],\"EVENING\":[17,19.5]}")
  /// A live answer cancels the remaining automated attempts that day.
  cancelRedialsOnAnswer Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lists List[]

  @@unique([tenantId, name])
}

enum ScrubStatus {
  PENDING
  CLEAN
  DNC
  LITIGATOR
  FAILED
}

enum LeadStatus {
  NEW
  IN_HOPPER
  DIALING
  CONTACTED
  CALLBACK
  FINISHED
  DNC
  BLOCKED
}

model Lead {
  id       String @id @default(cuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String
  list     List   @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId   String
  /// Ten digits. Unique per list (plan §11.1).
  phone    String

  firstName String?
  lastName  String?
  address   String?
  city      String?
  state     String?
  zip       String?
  email     String?
  /// IANA zone, resolved from ZIP first, area code second.
  timezone  String?
  /// Campaign-defined bucket, matched against DialPlan.leadType.
  leadType  String?
  postedAt  DateTime @default(now())

  consentJornayaId     String?
  consentTrustedFormId String?
  optInUrl             String?
  optInAt              DateTime?
  optInIp              String?
  rawPayload           Json?
  custom               Json     @default("{}")

  scrubStatus ScrubStatus @default(PENDING)
  scrubReason String?
  scrubbedAt  DateTime?

  status        LeadStatus @default(NEW)
  attemptsTotal Int        @default(0)
  lastAttemptAt DateTime?
  nextDialAt    DateTime?
  /// MORNING | AFTERNOON | EVENING of the last attempt, in the lead's zone.
  lastAttemptDaypart String?
  /// Caller ID the cadence picked, so the SMS and the dial share one number.
  assignedCallerId   String?
  /// Token for the self-service callback page sent in the missed-call SMS.
  callbackToken      String?   @unique
  /// Set when a live answer cancels the rest of the day's automated redials.
  redialsCancelledOn DateTime? @db.Date
  owner         User?      @relation("LeadOwner", fields: [ownerId], references: [id])
  ownerId       String?
  /// The last agent who spoke to, texted or left a message for this lead: a call back goes to them first (owner, 5 Nov).
  lastAgentId   String?
  /// Running free-text notes from the agent console's Lead card; each save also writes a NOTE event.
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events    LeadEvent[]
  calls     Call[]
  callbacks Callback[]
  messages  Message[]

  @@unique([listId, phone])
  @@index([tenantId, phone])
  @@index([listId, status, nextDialAt])
  @@index([tenantId, status])
}

enum LeadEventKind {
  POSTED
  IMPORTED
  SCRUBBED
  DIAL
  ANSWERED
  DISPOSITION
  NOTE
  TEXT_IN
  TEXT_OUT
  CALLBACK_SET
  WEBHOOK
  DNC
  BLOCKED
}

model LeadEvent {
  id        String        @id @default(cuid())
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  tenantId  String
  lead      Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  kind      LeadEventKind
  actor     User?         @relation(fields: [actorId], references: [id])
  actorId   String?
  data      Json          @default("{}")
  createdAt DateTime      @default(now())

  @@index([leadId, createdAt])
}

model Affiliate {
  id          String   @id @default(cuid())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  tenantId    String
  name        String
  /// Hashed; the plain key is shown once at creation.
  apiKeyHash  String   @unique
  apiKeyHint  String
  /// Inbound field name -> Strowger field name.
  fieldMapping Json    @default("{}")
  defaultListId String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  lists List[]
  users User[]

  @@unique([tenantId, name])
}

// ───────────────────────────── Compliance ─────────────────────────────

enum DncScope {
  SYSTEM
  CAMPAIGN
}

enum DncSource {
  MANUAL
  STOP_KEYWORD
  /// The AI read of a free-text reply found a request to stop.
  AI_OPT_OUT
  DISPOSITION
  IMPORT
  CROSSBAR
}

model DncEntry {
  id         String    @id @default(cuid())
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  tenantId   String
  phone      String
  scope      DncScope  @default(SYSTEM)
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String?
  source     DncSource @default(MANUAL)
  note       String?
  createdAt  DateTime  @default(now())

  @@unique([tenantId, phone, campaignId])
  @@index([tenantId, phone])
}

/// Seeded from packages/shared/compliance; not per tenant. `verifiedAt` stays
/// null until counsel has confirmed the row (plan §6).
model StateRule {
  state            String   @id
  startHour        Int
  endHour          Int
  /// Per-day-of-week overrides: {"0": {"startHour":12,"endHour":21}} or
  /// {"0": null} for no calls on Sunday.
  dayOverrides     Json     @default("{}")
  maxAttemptsPerDay Int?
  noHolidayCalls   Boolean  @default(false)
  citation         String?
  verifiedAt       DateTime?
  updatedAt        DateTime @updatedAt
}

/// Daily answered/abandoned per campaign, the inputs to the rolling 30-day rate.
model AbandonLedger {
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  tenantId   String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  day        DateTime @db.Date
  answered   Int      @default(0)
  abandoned  Int      @default(0)

  @@id([campaignId, day])
  @@index([tenantId, day])
}

// ───────────────────────────── Telephony assets ─────────────────────────────

enum CallerIdStatus {
  ACTIVE
  RESTING
  SPAM_FLAGGED
  RETIRED
}

/// What a carrier's analytics engine says about one of our numbers.
enum CarrierVerdict {
  GOOD
  FLAGGED
  SPAM
  BLOCKED
  UNKNOWN
}

model CallerIdNumber {
  id         String         @id @default(cuid())
  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  tenantId   String
  phone      String
  areaCode   String
  state      String?
  status     CallerIdStatus @default(ACTIVE)
  smsEnabled Boolean        @default(false)
  provider   String         @default("commio")
  lastUsedAt DateTime?
  usedToday  Int            @default(0)
  createdAt  DateTime       @default(now())

  /// Optional: pin a number to one campaign. Null = shared pool.
  campaign   Campaign?      @relation(fields: [campaignId], references: [id])
  campaignId String?

  /// Where an inbound call to this number goes.
  routeTo     InboundRoute @default(CAMPAIGN)
  ivr         Ivr?         @relation(fields: [ivrId], references: [id])
  ivrId       String?
  queue       Queue?       @relation(fields: [queueId], references: [id])
  queueId     String?
  routeUser   User?        @relation("NumberRouteUser", fields: [routeUserId], references: [id])
  routeUserId String?

  /// Latest reputation reading per carrier (the Big Three), the STIR/SHAKEN
  /// attestation seen on our outbound calls, and when we last checked.
  attVerdict    CarrierVerdict @default(UNKNOWN)
  verizonVerdict CarrierVerdict @default(UNKNOWN)
  tmobileVerdict CarrierVerdict @default(UNKNOWN)
  attestation   String?
  lastScannedAt DateTime?
  /// Re-check this number on the daily sweep.
  autoRecheck   Boolean        @default(true)

  /// Hygiene (owner, 4 Nov): registered at the Free Caller Registry before
  /// the first dial; warm-up caps by age; rest after a flag.
  registeredAt    DateTime?
  firstUsedAt     DateTime?
  /// Null = automatic by age: week 1 → 40/day, weeks 2–3 → 65/day, then 75/day.
  dailyCap        Int?
  /// Out of rotation until this time (auto-pull on a spam flag: 3 weeks).
  restUntil       DateTime?
  shortCallsToday Int       @default(0)

  /// Provisioning: ids at the carrier and in jambonz, and how far along the number is.
  /// manual = added by hand; ordered = bought, waiting at Telnyx; voice = in jambonz; ready = voice + messaging profile; failed.
  telnyxNumberId       String?
  jambonzPhoneNumberSid String?
  provisionStatus      String   @default("manual")
  provisionError       String?
  order                NumberOrder? @relation(fields: [orderId], references: [id])
  orderId              String?

  scans DidScan[]

  @@unique([tenantId, phone])
  @@index([tenantId, areaCode, status])
  @@index([tenantId, lastScannedAt])
}

/// One reputation reading of one number, kept so a change can be dated.
/// One purchase at the carrier: which area code, how many, for which campaign, and what came back.
model NumberOrder {
  id            String   @id @default(cuid())
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  tenantId      String
  campaign      Campaign? @relation(fields: [campaignId], references: [id])
  campaignId    String?
  areaCode      String
  quantity      Int
  telnyxOrderId String?
  /// pending | success | failure (Telnyx order status) or error
  status        String   @default("pending")
  error         String?
  requestedBy   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  numbers       CallerIdNumber[]

  @@index([tenantId, createdAt])
}

/// Floor chat. A channel is EVERYONE, MANAGERS (supervisors, room supervisors,
/// team leaders, admins), a TEAM (its members and leader), a CAMPAIGN (its
/// agents and every manager) or a DIRECT message (the two users, key = both
/// ids sorted and joined with ":"). Delivery is by socket to each recipient.
model ChatMessage {
  id        String   @id @default(cuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  String
  channel   ChatChannel
  /// teamId, campaignId, or "a:b" for DIRECT; null for EVERYONE and MANAGERS.
  channelId String?
  sender    User     @relation("ChatSender", fields: [senderId], references: [id])
  senderId  String
  body      String
  createdAt DateTime @default(now())

  @@index([tenantId, channel, channelId, createdAt])
}

enum ChatChannel {
  EVERYONE
  MANAGERS
  TEAM
  CAMPAIGN
  DIRECT
}

/// Games (owner, 5 Nov). A bet between two agents on a stat, paid in points.
model Wager {
  id          String      @id @default(cuid())
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  tenantId    String
  proposer    User        @relation("WagerProposer", fields: [proposerId], references: [id])
  proposerId  String
  accepter    User?       @relation("WagerAccepter", fields: [accepterId], references: [id])
  accepterId  String?
  /// The campaign the bet is on (bets are switched on per campaign). Null only on bets from before that.
  campaignId  String?
  /// NEXT_SALE, NEXT_CALL, NEXT_CONTACT, MOST_CALLS_TODAY, MOST_CONTACTS_TODAY, MOST_SALES_TODAY, MOST_SALES_WEEK
  kind        String
  stake       Int
  status      WagerStatus @default(OPEN)
  /// For "most … today/week": the period key the bet settles on (YYYY-MM-DD or YYYY-Www).
  period      String?
  winnerId    String?
  note        String?
  createdAt   DateTime    @default(now())
  settledAt   DateTime?

  @@index([tenantId, status, createdAt])
  @@index([tenantId, campaignId, status])
}

enum WagerStatus {
  OPEN
  ACCEPTED
  SETTLED
  DECLINED
  VOID
}

model PointsLedger {
  id        String   @id @default(cuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  delta     Int
  reason    String
  wagerId   String?
  createdAt DateTime @default(now())

  @@index([tenantId, userId, createdAt])
}

/// Poker run: an admin starts one per campaign with a name, a window, a prize
/// and the rule for what deals a card; the best five-card hand when it ends wins.
model PokerRun {
  id          String         @id @default(cuid())
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  tenantId    String
  campaign    Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId  String
  name        String
  startsAt    DateTime
  endsAt      DateTime
  /// Display only; paying it is the owner's.
  prize       String?
  /// SALE | CONTACT | CODES (see shared/games POKER_QUALIFIERS).
  qualifies   String         @default("SALE")
  /// Disposition codes that deal a card when qualifies = CODES.
  qualifyingCodes String[]   @default([])
  status      PokerRunStatus @default(ACTIVE)
  createdBy   User           @relation("PokerRunCreator", fields: [createdById], references: [id])
  createdById String
  /// Set when the run ends: the best hand and who held it.
  winnerId    String?
  /// {"userId","name","hand","cards":[…]} for the winner; null when nobody had a card.
  winningHand Json?
  endedAt     DateTime?
  createdAt   DateTime       @default(now())

  cards PokerCard[]

  @@index([tenantId, campaignId, status])
}

enum PokerRunStatus {
  ACTIVE
  ENDED
}

/// A card dealt in a poker run (one per qualifying outcome).
model PokerCard {
  id        String    @id @default(cuid())
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  tenantId  String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// The run the card belongs to. Null only on cards from before explicit runs.
  run       PokerRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId     String?
  /// Legacy period key (YYYY-MM-DD or YYYY-Www) from before runs; the ISO week the card was dealt in since.
  period    String
  /// e.g. "AS", "TD", "9H", "2C"
  card      String
  callId    String?
  dealtAt   DateTime  @default(now())

  @@index([tenantId, period, userId])
  @@index([runId, userId])
}

/// Billing (owner, 5 Nov): prepaid per client. A seat is an agent who logs in
/// during the month; admins and managers are free. Minutes, DIDs (cost + 50%),
/// scrub records (cost + margin) and texts are charged as they happen. Prices
/// are in millicents (1/1000 of a cent) so 1.2¢/min is 1200.
model BillingAccount {
  id                   String   @id @default(cuid())
  tenant               Tenant   @relation(fields: [tenantId], references: [id])
  tenantId             String   @unique
  balanceCents         Int      @default(0)
  seatMonthlyCents     Int      @default(7000)
  perMinuteMillicents  Int      @default(1200)
  /// Markup on the DID monthly cost, percent (50 = cost + 50%).
  didMarkupPct         Int      @default(50)
  /// Added on top of our scrub cost, per record.
  scrubMarginMillicents Int     @default(500)
  /// Per text segment sent, price to the client.
  smsPriceMillicents   Int      @default(1500)
  /// Warn below this balance.
  lowBalanceCents      Int      @default(20000)
  /// Days the balance may sit at or below zero before outbound is paused.
  graceDays            Int      @default(3)
  suspended            Boolean  @default(false)
  suspendedAt          DateTime?
  zeroSince            DateTime?
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

enum BillingKind {
  CHARGE
  PAYMENT
  ADJUSTMENT
}

enum BillingCategory {
  SEAT
  MINUTES
  DID
  SCRUB
  SMS
  OTHER
  PAYMENT
}

/// The ledger. Charges are negative amounts; payments positive. costCents is what we paid, for margin.
model BillingEntry {
  id          String          @id @default(cuid())
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  tenantId    String
  kind        BillingKind
  category    BillingCategory
  quantity    Decimal         @default(1) @db.Decimal(14, 4)
  unitMillicents Int          @default(0)
  amountCents Int
  costCents   Int             @default(0)
  /// rate = computed from PlatformRates; telnyx = replaced by the carrier's actual charge.
  costSource  String          @default("rate")
  note        String?
  refId       String?
  /// YYYY-MM the charge belongs to.
  period      String
  createdById String?
  createdAt   DateTime        @default(now())

  @@index([tenantId, period, category])
  @@index([tenantId, createdAt])
}

/// Platform-wide cost rates (what we pay), one row. Edited on /platform.
model PlatformRates {
  id                       String   @id @default("default")
  telnyxOutMillicentsPerMin Int     @default(500)
  telnyxInMillicentsPerMin  Int     @default(320)
  didMonthlyCents          Int      @default(110)
  scrubCostMillicents      Int      @default(500)
  smsCostMillicents        Int      @default(400)
  /// Shown to clients on their billing page: how to prepay.
  prepayInstructions       String?
  /// Last Telnyx account balance seen (GET /v2/balance) and when.
  telnyxBalanceCents       Int?
  telnyxBalanceAt          DateTime?
  telnyxSyncedAt           DateTime?
  updatedAt                DateTime @updatedAt
}

/// What vendors charge us, as pulled from their APIs or computed from token usage. One row per record (call, message, AI request) or per day for aggregates.
model VendorUsage {
  id        String   @id @default(cuid())
  tenantId  String?
  vendor    String
  /// sip-trunking, messaging, amd, conference, ai.classify, ai.assist, …
  kind      String
  quantity  Decimal  @default(1) @db.Decimal(14, 4)
  costCents Int
  day       String
  vendorRecordId String?
  refId     String?
  createdAt DateTime @default(now())

  @@unique([vendor, vendorRecordId])
  @@index([vendor, day])
  @@index([tenantId, day])
}

model DidScan {
  id             String         @id @default(cuid())
  number         CallerIdNumber @relation(fields: [numberId], references: [id], onDelete: Cascade)
  numberId       String
  vendor         String
  attVerdict     CarrierVerdict @default(UNKNOWN)
  verizonVerdict CarrierVerdict @default(UNKNOWN)
  tmobileVerdict CarrierVerdict @default(UNKNOWN)
  attestation    String?
  raw            Json?
  createdAt      DateTime       @default(now())

  @@index([numberId, createdAt])
}

enum InboundRoute {
  CAMPAIGN
  IVR
  QUEUE
  USER
}

/// Something an agent can do: a language, a product line, a support tier.
model Skill {
  id       String @id @default(cuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String
  name     String
  agents   AgentSkill[]

  @@unique([tenantId, name])
}

model AgentSkill {
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  skill   Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId String
  /// 1 (basic) to 5 (expert).
  level   Int   @default(3)

  @@id([userId, skillId])
}

/// A menu: greeting, digit options, optional extension dialing.
model Ivr {
  id              String  @id @default(cuid())
  tenant          Tenant  @relation(fields: [tenantId], references: [id])
  tenantId        String
  name            String
  greetingAudioId String?
  /// [{ "digit": "1", "label": "Sales", "action": "QUEUE"|"USER"|"VOICEMAIL"|"IVR"|"HANGUP", "targetId": "…" }]
  options         Json    @default("[]")
  /// Callers may dial an agent's extension at any time.
  allowExtensions Boolean @default(true)
  /// What happens on no input after `timeoutSeconds` and `repeats` replays.
  timeoutSeconds  Int     @default(6)
  repeats         Int     @default(2)
  timeoutAction   String  @default("HANGUP")
  timeoutTargetId String?
  numbers         CallerIdNumber[]

  @@unique([tenantId, name])
}

/// Callers wait here for an agent with the right skills.
model Queue {
  id              String   @id @default(cuid())
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  tenantId        String
  name            String
  /// [{ "skillId": "…", "minLevel": 3 }] — all required.
  requiredSkills  Json     @default("[]")
  /// Campaign whose agents are preferred and whose context the call carries.
  campaign        Campaign? @relation(fields: [campaignId], references: [id])
  campaignId      String?
  holdAudioId     String?
  maxWaitSeconds  Int      @default(300)
  /// VOICEMAIL | QUEUE | HANGUP
  overflowAction  String   @default("VOICEMAIL")
  overflowQueueId String?
  voicemailBox    VoicemailBox? @relation(fields: [voicemailBoxId], references: [id])
  voicemailBoxId  String?
  numbers         CallerIdNumber[]

  @@unique([tenantId, name])
}

model VoicemailBox {
  id              String  @id @default(cuid())
  tenant          Tenant  @relation(fields: [tenantId], references: [id])
  tenantId        String
  name            String
  owner           User?   @relation("BoxOwner", fields: [ownerId], references: [id])
  ownerId         String?
  greetingAudioId String?
  notifyEmail     String?
  queues          Queue[]
  messages        Voicemail[]

  @@unique([tenantId, name])
}

enum VoicemailStatus {
  NEW
  LISTENED
  DONE
}

model Voicemail {
  id           String          @id @default(cuid())
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  tenantId     String
  box          VoicemailBox    @relation(fields: [boxId], references: [id], onDelete: Cascade)
  boxId        String
  callId       String?
  fromPhone    String
  durationSec  Int?
  recordingUrl String?
  transcript   String?
  status       VoicemailStatus @default(NEW)
  assignee     User?           @relation("VoicemailAssignee", fields: [assigneeId], references: [id])
  assigneeId   String?
  createdAt    DateTime        @default(now())

  @@index([tenantId, status, createdAt])
  @@index([boxId, createdAt])
}

enum AudioKind {
  SAFE_HARBOR
  VOICEMAIL_DROP
  SCREENER_MESSAGE
  DISCLOSURE
  HOLD
  IVR_GREETING
  VM_GREETING
  OTHER
}

model AudioAsset {
  id         String    @id @default(cuid())
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  tenantId   String
  kind       AudioKind
  name       String
  storageUrl String
  createdAt  DateTime  @default(now())
}

// ───────────────────────────── Calls & activity ─────────────────────────────

enum CallDirection {
  OUTBOUND
  INBOUND
  MANUAL
}

enum AmdResult {
  HUMAN
  MACHINE
  SCREENER
  UNKNOWN
}

enum CallOutcome {
  BRIDGED
  VOICEMAIL
  VOICEMAIL_DROPPED
  SCREENER_MESSAGE
  SCREENER_AGENT
  SCREENER_HANGUP
  ABANDONED
  NO_ANSWER
  BUSY
  FAILED
  CANCELLED
}

model Call {
  id         String        @id @default(cuid())
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  tenantId   String
  campaign   Campaign?     @relation(fields: [campaignId], references: [id])
  campaignId String?
  lead       Lead?         @relation(fields: [leadId], references: [id])
  leadId     String?
  agent      User?         @relation(fields: [agentId], references: [id])
  agentId    String?
  direction  CallDirection
  phone      String
  callerId   String?
  providerCallId String?   @unique

  dialedAt   DateTime  @default(now())
  ringingAt  DateTime?
  answeredAt DateTime?
  bridgedAt  DateTime?
  endedAt    DateTime?
  /// What the carrier actually charged for this call (from Telnyx detail records), and its record id.
  vendorCostCents Int?
  vendorRecordId  String?

  amdResult        AmdResult?
  screenerDetected Boolean     @default(false)
  outcome          CallOutcome?
  abandoned        Boolean     @default(false)
  disposition      Disposition? @relation(fields: [dispositionId], references: [id])
  dispositionId    String?
  notes            String?

  recordingUrl       String?
  recordingExpiresAt DateTime?
  /// Where the nightly export put it (sftp://host/path or dropbox:/path).
  recordingExportedTo String?
  recordingDeletedAt DateTime?
  legalHold          Boolean   @default(false)
  costCents          Int?
  /// Raw provider facts worth keeping (final SIP status, AMD events).
  providerData       Json      @default("{}")

  transfers Transfer[]

  @@index([tenantId, dialedAt])
  @@index([campaignId, dialedAt])
  @@index([leadId, dialedAt])
  @@index([agentId, dialedAt])
}

enum TransferKind {
  WARM
  COLD
}

model Transfer {
  id         String       @id @default(cuid())
  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  tenantId   String
  call       Call         @relation(fields: [callId], references: [id], onDelete: Cascade)
  callId     String
  fromAgent  User         @relation("TransferFrom", fields: [fromAgentId], references: [id])
  fromAgentId String
  toAgent    User?        @relation("TransferTo", fields: [toAgentId], references: [id])
  toAgentId  String?
  kind       TransferKind @default(WARM)
  createdAt  DateTime     @default(now())
  completedAt DateTime?
}

enum CallbackScope {
  AGENT
  CAMPAIGN
}

enum CallbackStatus {
  SCHEDULED
  OFFERED
  DONE
  MISSED
  CANCELLED
}

model Callback {
  id         String         @id @default(cuid())
  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  tenantId   String
  campaign   Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  lead       Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId     String
  agent      User?          @relation(fields: [agentId], references: [id])
  agentId    String?
  scope      CallbackScope  @default(AGENT)
  dueAt      DateTime
  status     CallbackStatus @default(SCHEDULED)
  note       String?
  createdAt  DateTime       @default(now())

  @@index([campaignId, status, dueAt])
  @@index([agentId, status, dueAt])
}

enum AgentState {
  LOGGED_IN
  READY
  RESERVED
  ON_CALL
  WRAP_UP
  PAUSED
  LOGGED_OUT
}

/// One row per agent login, with a running log of state changes in `events`
/// for productivity reporting. Live state itself lives in Redis.
model AgentSession {
  id         String     @id @default(cuid())
  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  tenantId   String
  user       User       @relation(fields: [userId], references: [id])
  userId     String
  campaign   Campaign?  @relation(fields: [campaignId], references: [id])
  campaignId String?
  startedAt  DateTime   @default(now())
  endedAt    DateTime?
  lastState  AgentState @default(LOGGED_IN)
  events     Json       @default("[]")

  @@index([tenantId, startedAt])
  @@index([userId, startedAt])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  RECEIVED
}

model Message {
  id         String           @id @default(cuid())
  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  tenantId   String
  campaign   Campaign?        @relation(fields: [campaignId], references: [id])
  campaignId String?
  lead       Lead?            @relation(fields: [leadId], references: [id])
  leadId     String?
  agent      User?            @relation(fields: [agentId], references: [id])
  agentId    String?
  direction  MessageDirection
  fromPhone  String
  toPhone    String
  body       String
  provider   String           @default("commio")
  providerMessageId String?   @unique
  status     MessageStatus    @default(QUEUED)
  /// Which automated touch sent it: pre_call, missed_call, or null for manual.
  purpose    String?
  error      String?
  /// AI read of an inbound reply: OPT_OUT, CALLBACK_REQUEST, QUESTION, WRONG_NUMBER, INTERESTED, NOT_INTERESTED, OTHER. Null = keyword matched or AI not configured.
  intent           String?
  intentConfidence Float?
  intentReason     String?
  vendorCostCents  Int?
  createdAt  DateTime         @default(now())

  @@index([leadId, createdAt])
  @@index([tenantId, createdAt])
}

// ───────────────────────────── Integration & audit ─────────────────────────────

model WebhookEndpoint {
  id         String    @id @default(cuid())
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  tenantId   String
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String?
  url        String
  secret     String
  /// Event names, e.g. ["disposition", "sale", "callback"].
  events     String[]
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  deliveries WebhookDelivery[]
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

model WebhookDelivery {
  id          String          @id @default(cuid())
  endpoint    WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  endpointId  String
  event       String
  payload     Json
  status      DeliveryStatus  @default(PENDING)
  attempts    Int             @default(0)
  lastError   String?
  createdAt   DateTime        @default(now())
  deliveredAt DateTime?

  @@index([endpointId, status, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  String
  actor     User?    @relation(fields: [actorId], references: [id])
  actorId   String?
  action    String
  target    String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}
