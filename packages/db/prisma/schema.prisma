// Strowger data model. Every business table carries tenantId: this is a
// multi-tenant product from the first migration. See docs/PLAN.md §5.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Tenancy & people ─────────────────────────────

model Tenant {
  id                        String           @id @default(cuid())
  slug                      String           @unique
  name                      String
  /// Clerk organization id, when the tenant is backed by a Clerk org.
  clerkOrgId                String?          @unique
  settings                  Json             @default("{}")
  /// Recording retention in days (owner, 4 Nov: 30–60 to keep storage cost down).
  recordingRetentionDays    Int              @default(60)
  /// Nightly batch export of recordings before they expire:
  /// {"type":"sftp","host":"","port":22,"username":"","password":"<enc>","path":"/recordings"}
  /// or {"type":"dropbox","token":"<enc>","path":"/Strowger"}; null = no export.
  recordingExport           Json?
  /// Carrier provisioning (owner, 4 Nov: order and register numbers from Strowger).
  /// Telnyx resources this tenant's numbers are attached to, and the jambonz carrier.
  telnyxConnectionId        String?
  telnyxOutboundProfileId   String?
  telnyxMessagingProfileId  String?
  jambonzCarrierSid         String?
  /// 10DLC (A2P texting registration) at Telnyx: brand and campaign ids plus the last snapshot seen.
  tenDlcBrandId             String?
  tenDlcCampaignId          String?
  tenDlcBrand               Json?
  tenDlcCampaign            Json?
  /// The owner's own workspace: sees every client's billing and sets cost rates (one tenant).
  isPlatform                Boolean          @default(false)
  billing                   BillingAccount?
  billingEntries            BillingEntry[]
  /// Referral program and free trial (owner, 6 Nov; docs/HANDOFF.md "Referral program and free trial").
  /// The client's own link code (/r/<code>), made on its first visit to Refer & earn.
  referralCode              String?          @unique
  referralTermsAcceptedAt   DateTime?
  referralTermsVersion      String?
  referralTermsAcceptedById String?
  /// Per-referrer commission percent; null = PlatformRates.referralPct.
  referralPctOverride       Decimal?         @db.Decimal(5, 2)
  /// Who referred this client (mirrors Referral.tenantId for the row where this tenant is referred).
  referredByTenantId        String?
  /// Business phone given at sign-up (ten digits): one trial per business.
  businessPhone             String?
  trialStartedAt            DateTime?
  trialEndsAt               DateTime?
  /// First payment recorded: the trial limits lift and the referral locks.
  trialConvertedAt          DateTime?
  trialReminderAt           DateTime?
  /// The trial-end job has run (leftover allowance removed; suspended if never paid).
  trialClosedAt             DateTime?
  trialSeats                Int?
  trialMaxNumbers           Int?
  trialAllowanceCents       Int?
  trialTermsAcceptedAt      DateTime?
  trialTermsVersion         String?
  usageTermsAcceptedAt      DateTime?
  /// Workspace closed: referral credits stop and its referrals end.
  closedAt                  DateTime?
  referralsMade             Referral[]       @relation("referrer")
  referredBy                Referral?        @relation("referred")
  referralPayouts           ReferralPayout[]
  trialClaims               TrialClaim[]
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  users                User[]
  rooms                Room[]
  teams                Team[]
  campaigns            Campaign[]
  lists                List[]
  leads                Lead[]
  affiliates           Affiliate[]
  dncEntries           DncEntry[]
  callerIds            CallerIdNumber[]
  numberOrders         NumberOrder[]
  chatMessages         ChatMessage[]
  wagers               Wager[]
  pointsLedger         PointsLedger[]
  pokerCards           PokerCard[]
  pokerRuns            PokerRun[]
  audioAssets          AudioAsset[]
  calls                Call[]
  messages             Message[]
  webhooks             WebhookEndpoint[]
  auditLogs            AuditLog[]
  agentSessions        AgentSession[]
  callbacks            Callback[]
  leadEvents           LeadEvent[]
  abandonLedger        AbandonLedger[]
  transfers            Transfer[]
  transferDestinations TransferDestination[]
  campaignAgents       CampaignAgent[]
  dispositions         Disposition[]
  dialPlans            DialPlan[]
  scripts              Script[]
  cadences             CadenceProfile[]
  skills               Skill[]
  ivrs                 Ivr[]
  queues               Queue[]
  voicemailBoxes       VoicemailBox[]
  voicemails           Voicemail[]
  schedules            Schedule[]
  geoRoutes            GeoRoute[]
  queueCallbacks       QueueCallback[]
}

enum Role {
  ADMIN
  SUPERVISOR
  ROOM_SUPERVISOR
  TEAM_LEADER
  AGENT
  AFFILIATE
}

model User {
  id                 String           @id @default(cuid())
  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  tenantId           String
  clerkUserId        String?          @unique
  email              String
  firstName          String?
  lastName           String?
  roles              Role[]           @default([AGENT])
  /// Agent level 1–8 (owner, 5 Nov): rights per level are tenant settings (`levelRights`).
  level              Int              @default(1)
  /// Where to text the agent (voicemail alerts). E.164 digits.
  mobilePhone        String?
  /// Text me when a voicemail lands in my box (also needs the campaign switch).
  notifyVoicemailSms Boolean          @default(true)
  /// Game points (bets); topped up weekly from tenant settings.
  points             Int              @default(0)
  active             Boolean          @default(true)
  /// SIP credentials for the browser softphone. The password is stored
  /// encrypted (AES-GCM under a key derived from ENGINE_INTERNAL_KEY): the
  /// registration hook needs it to verify digests and the agent's own browser
  /// needs it to register. Never shown to anyone else.
  sipUsername        String?          @unique
  sipSecret          String?
  /// Platform admins only: the client workspace they last opened from
  /// /platform, so the page can offer "Continue in <client>" next time.
  lastWorkspaceId    String?
  /// For AFFILIATE-role users: the partner whose lists they may see.
  affiliate          Affiliate?       @relation(fields: [affiliateId], references: [id])
  affiliateId        String?
  /// Short dialable extension (e.g. 101), unique per tenant.
  extension          String?
  skills             AgentSkill[]
  voicemailBoxes     VoicemailBox[]   @relation("BoxOwner")
  voicemails         Voicemail[]      @relation("VoicemailAssignee")
  routedNumbers      CallerIdNumber[] @relation("NumberRouteUser")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  rooms            UserRoom[]
  teams            UserTeam[]
  ledTeams         Team[]          @relation("TeamLeader")
  chatSent         ChatMessage[]   @relation("ChatSender")
  wagersProposed   Wager[]         @relation("WagerProposer")
  wagersAccepted   Wager[]         @relation("WagerAccepter")
  pointsLedger     PointsLedger[]
  pokerCards       PokerCard[]
  pokerRunsStarted PokerRun[]      @relation("PokerRunCreator")
  supervisedRooms  Room[]          @relation("RoomSupervisor")
  campaignAgents   CampaignAgent[]
  agentSessions    AgentSession[]
  calls            Call[]
  callbacks        Callback[]
  ownedLeads       Lead[]          @relation("LeadOwner")
  leadEvents       LeadEvent[]
  auditLogs        AuditLog[]
  transfersFrom    Transfer[]      @relation("TransferFrom")
  transfersTo      Transfer[]      @relation("TransferTo")
  messages         Message[]

  @@unique([tenantId, email])
  @@unique([tenantId, extension])
  @@index([tenantId])
}

/// A physical location or floor. Several rooms may work one campaign.
model Room {
  id           String     @id @default(cuid())
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  tenantId     String
  name         String
  supervisor   User?      @relation("RoomSupervisor", fields: [supervisorId], references: [id])
  supervisorId String?
  members      UserRoom[]
  teams        Team[]

  @@unique([tenantId, name])
}

model UserRoom {
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId String

  @@id([userId, roomId])
}

/// A team leader and the agents under them. A team may sit inside a room.
model Team {
  id       String     @id @default(cuid())
  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  tenantId String
  name     String
  leader   User?      @relation("TeamLeader", fields: [leaderId], references: [id])
  leaderId String?
  room     Room?      @relation(fields: [roomId], references: [id])
  roomId   String?
  members  UserTeam[]

  @@unique([tenantId, name])
}

model UserTeam {
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  @@id([userId, teamId])
}

// ───────────────────────────── Campaigns ─────────────────────────────

enum DialMode {
  RATIO
  PREVIEW
}

enum VoicemailAction {
  HANGUP
  DROP
}

enum VoicemailMode {
  FILE
  TTS
}

enum ScreenerAction {
  MESSAGE
  AGENT
  HANGUP
}

enum CallerIdMode {
  FIXED
  LOCAL_PRESENCE
}

/// Local presence when no number with the lead's area code is free:
/// ANY = any area code (the original behaviour); SAME_STATE = only numbers in
/// the lead's state; EXACT_ONLY = only the exact area code, else the fixed
/// caller ID if set, else the lead waits.
enum CallerIdFallback {
  ANY
  SAME_STATE
  EXACT_ONLY
}

enum HopperOrder {
  LIFO
  FIFO
  PRIORITY
}

enum ListSelection {
  STRICT_PRIORITY
  WEIGHTED_ROUND_ROBIN
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

model Campaign {
  id       String         @id @default(cuid())
  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  tenantId String
  name     String
  status   CampaignStatus @default(DRAFT)

  dialMode DialMode @default(PREVIEW)
  /// Lines per ready agent in RATIO mode. The pacing loop never exceeds it.
  ratio    Decimal  @default(1.0) @db.Decimal(4, 2)
  maxRatio Decimal  @default(3.0) @db.Decimal(4, 2)

  /// Abandon cap, rolling 30 days, percent. 3.0 is the FTC safe harbor.
  abandonCapPct     Decimal @default(3.0) @db.Decimal(4, 2)
  /// Ratio starts stepping down when the 30-day rate reaches this.
  abandonWarnPct    Decimal @default(2.5) @db.Decimal(4, 2)
  /// A human answer not bridged within this many ms is an abandon.
  abandonTimerMs    Int     @default(2000)
  safeHarborAudioId String?

  amdEnabled            Boolean         @default(true)
  voicemailAction       VoicemailAction @default(HANGUP)
  voicemailDropAudioId  String?
  /// FILE plays voicemailDropAudioId; TTS speaks voicemailScript with
  /// variables ({{first_name}}, {{last_name}}, {{company}}, {{callback_number}},
  /// {{agent}}). TTS needs a speech vendor on the jambonz account.
  voicemailMode         VoicemailMode   @default(FILE)
  voicemailScript       String?
  /// Minutes before a lead that reached voicemail is tried again.
  voicemailRetryMinutes Int             @default(240)
  /// Text the owning agent when a caller leaves them a voicemail (per-agent switch too).
  voicemailNotifySms    Boolean         @default(true)
  /// Agent assist: [{"objection":"…","response":"…"}]
  rebuttals             Json?

  screenerDetection Boolean        @default(true)
  screenerAction    ScreenerAction @default(MESSAGE)
  screenerAudioId   String?
  /// What the agent reads to a call screener when screenerAction is AGENT
  /// (console banner). Null = the default in shared/scripts.ts.
  screenerScript    String?

  recordingOn       Boolean @default(true)
  disclosureOn      Boolean @default(false)
  disclosureAudioId String?

  callerIdMode     CallerIdMode     @default(LOCAL_PRESENCE)
  fixedCallerId    String?
  callerIdFallback CallerIdFallback @default(ANY)

  /// Campaign's own calling window in the lead's local time. State and
  /// federal rules still apply on top; the most restrictive wins.
  localWindowStart  Int           @default(9)
  localWindowEnd    Int           @default(20)
  /// Optional day x hour grid in the lead's local time: 7 arrays (Sun..Sat)
  /// of 24 flags. Null = the start/end window applies every day.
  allowedHours      Json?
  /// Campaign default attempts per lead (phone) per day. Dial plans may raise
  /// it, never above the state cap.
  maxAttemptsPerDay Int           @default(3)
  wrapUpSeconds     Int           @default(30)
  hopperOrder       HopperOrder   @default(LIFO)
  /// How lists of different priority tiers share the dialer.
  listSelection     ListSelection @default(STRICT_PRIORITY)

  /// Whether closers may turn outbound on for themselves (plan §11.7).
  closersMayDial       Boolean @default(true)
  /// Minutes an agent-scoped callback waits for its owner before it is
  /// offered to the campaign.
  callbackOwnerMinutes Int     @default(30)

  /// Games (owner, 5 Nov): switched on per campaign. Bets between agents on
  /// this campaign; the Monday allowance and stake cap apply to its agents.
  /// Defaults for new campaigns come from Tenant.settings.games.
  betsEnabled  Boolean @default(false)
  weeklyPoints Int     @default(10000)
  maxStake     Int     @default(5000)

  /// Live transcription and agent assist (HANDOFF "Live transcription and agent assist"). All off by default.
  transcriptionOn          Boolean  @default(false)
  liveAssistOn             Boolean  @default(false)
  assistModel              String   @default("claude-haiku-5-5")
  assistMinGapSeconds      Int      @default(8)
  assistMaxPerCall         Int      @default(40)
  /// The agent must say the recording disclosure within 30 s of the join (alert when not heard).
  spokenDisclosureRequired Boolean  @default(false)
  disclosurePhrases        String[] @default(["recorded", "recording", "quality and training", "monitored", "transcribed"])
  bannedPhrases            String[] @default(["guaranteed", "free", "no cost", "risk-free"])
  postCallSummaryOn        Boolean  @default(false)
  suggestDispositionOn     Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pokerRuns            PokerRun[]
  lists                List[]
  agents               CampaignAgent[]
  dispositions         Disposition[]
  dialPlans            DialPlan[]
  scripts              Script[]
  calls                Call[]
  callbacks            Callback[]
  dncEntries           DncEntry[]
  abandonLedger        AbandonLedger[]
  agentSessions        AgentSession[]
  messages             Message[]
  webhooks             WebhookEndpoint[]
  callerIds            CallerIdNumber[]
  numberOrders         NumberOrder[]
  queues               Queue[]
  transferDestinations TransferDestination[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
}

enum AgentMode {
  FRONTER
  CLOSER
  BOTH
}

model CampaignAgent {
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  tenantId   String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  agentMode  AgentMode @default(BOTH)
  /// For CLOSER mode: outbound currently switched on (the checkbox).
  outboundOn Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@id([campaignId, userId])
  @@index([tenantId, userId])
}

/// How a campaign dials a lead of a given type at a given age. The strategy
/// names an algorithm in the engine; `fixed_gap` is the first. This is the
/// seat of the retry work that is meant to set the product apart.
model DialPlan {
  id              String   @id @default(cuid())
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  tenantId        String
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId      String
  /// Lead bucket this plan applies to; null = any.
  leadType        String?
  ageFromDays     Int      @default(0)
  ageToDays       Int?
  attemptsPerDay  Int      @default(3)
  retryGapMinutes Int      @default(180)
  /// Higher weight = earlier in a PRIORITY-ordered hopper.
  weight          Int      @default(0)
  strategy        String   @default("fixed_gap")
  params          Json     @default("{}")
  active          Boolean  @default(true)

  @@index([campaignId, active])
}

model Disposition {
  id                  String   @id @default(cuid())
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  tenantId            String
  campaign            Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId          String
  code                String
  label               String
  hotkey              String?
  isContact           Boolean  @default(false)
  isSale              Boolean  @default(false)
  isDnc               Boolean  @default(false)
  isCallback          Boolean  @default(false)
  /// Null = the lead is finished; otherwise it recycles after this long.
  recycleAfterMinutes Int?
  sortOrder           Int      @default(0)
  active              Boolean  @default(true)

  calls Call[]

  @@unique([campaignId, code])
}

model Script {
  id         String   @id @default(cuid())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  tenantId   String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  version    Int      @default(1)
  body       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([campaignId, version])
}

// ───────────────────────────── Lists & leads ─────────────────────────────

enum ListSource {
  UPLOAD
  POST
}

enum ListStatus {
  IMPORTING
  ACTIVE
  PAUSED
  ARCHIVED
}

enum DuplicateAction {
  REJECT
  ACCEPT
  UPDATE
}

model List {
  id               String          @id @default(cuid())
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  tenantId         String
  campaign         Campaign?       @relation(fields: [campaignId], references: [id])
  campaignId       String?
  name             String
  source           ListSource      @default(UPLOAD)
  affiliate        Affiliate?      @relation(fields: [affiliateId], references: [id])
  affiliateId      String?
  status           ListStatus      @default(ACTIVE)
  /// What to do with a phone already in this list.
  duplicateAction  DuplicateAction @default(REJECT)
  /// 1 = high, 2 = medium, 3 = low. Strict priority dials every eligible
  /// tier-1 lead before any tier-2 lead.
  priority         Int             @default(2)
  cadence          CadenceProfile? @relation(fields: [cadenceProfileId], references: [id])
  cadenceProfileId String?
  /// Counters kept current by the import and posting paths.
  totalLeads       Int             @default(0)
  dialableLeads    Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  leads   Lead[]
  imports ListImport[]

  @@unique([tenantId, name])
  @@index([campaignId, status])
}

enum ImportStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
}

model ListImport {
  id            String       @id @default(cuid())
  list          List         @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId        String
  fileName      String
  storageUrl    String?
  mapping       Json
  status        ImportStatus @default(QUEUED)
  totalRows     Int          @default(0)
  acceptedRows  Int          @default(0)
  duplicateRows Int          @default(0)
  badPhoneRows  Int          @default(0)
  dncRows       Int          @default(0)
  litigatorRows Int          @default(0)
  errorReason   String?
  createdAt     DateTime     @default(now())
  finishedAt    DateTime?
}

enum CadenceKind {
  FRESH
  AGED
}

/// The rules a list dials by: how fast, how often, in which dayparts, and
/// which texts go out around the call. Attached to lists; a campaign's dial
/// plans still apply where a list has no cadence.
model CadenceProfile {
  id       String      @id @default(cuid())
  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  tenantId String
  name     String
  kind     CadenceKind @default(AGED)

  /// FRESH: dial within seconds of the post (when an agent is Ready).
  instantDial         Boolean @default(false)
  /// Seconds between the pre-call text and the dial.
  instantDelaySeconds Int     @default(15)
  /// Text sent from the dialing number just before the call. Null = none.
  preCallSms          String?
  /// Text sent when the call is not answered. Null = none.
  missedCallSms       String?

  maxAttemptsPerDay     Int     @default(3)
  minGapMinutes         Int     @default(240)
  /// AGED: rotate dayparts so consecutive attempts never share a window.
  rotateDayparts        Boolean @default(false)
  /// {"MORNING":[8.5,11.5],"AFTERNOON":[12.5,16.5],"EVENING":[17,19.5]} local hours.
  dayparts              Json    @default("{\"MORNING\":[8.5,11.5],\"AFTERNOON\":[12.5,16.5],\"EVENING\":[17,19.5]}")
  /// A live answer cancels the remaining automated attempts that day.
  cancelRedialsOnAnswer Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lists List[]

  @@unique([tenantId, name])
}

enum ScrubStatus {
  PENDING
  CLEAN
  DNC
  LITIGATOR
  FAILED
}

enum LeadStatus {
  NEW
  IN_HOPPER
  DIALING
  CONTACTED
  CALLBACK
  FINISHED
  DNC
  BLOCKED
}

model Lead {
  id       String @id @default(cuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String
  list     List   @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId   String
  /// Ten digits. Unique per list (plan §11.1).
  phone    String

  firstName String?
  lastName  String?
  address   String?
  city      String?
  state     String?
  zip       String?
  email     String?
  /// IANA zone, resolved from ZIP first, area code second.
  timezone  String?
  /// Campaign-defined bucket, matched against DialPlan.leadType.
  leadType  String?
  postedAt  DateTime @default(now())

  consentJornayaId     String?
  consentTrustedFormId String?
  optInUrl             String?
  optInAt              DateTime?
  optInIp              String?
  rawPayload           Json?
  custom               Json      @default("{}")

  scrubStatus ScrubStatus @default(PENDING)
  scrubReason String?
  scrubbedAt  DateTime?

  status             LeadStatus @default(NEW)
  attemptsTotal      Int        @default(0)
  lastAttemptAt      DateTime?
  nextDialAt         DateTime?
  /// MORNING | AFTERNOON | EVENING of the last attempt, in the lead's zone.
  lastAttemptDaypart String?
  /// Caller ID the cadence picked, so the SMS and the dial share one number.
  assignedCallerId   String?
  /// Token for the self-service callback page sent in the missed-call SMS.
  callbackToken      String?    @unique
  /// Set when a live answer cancels the rest of the day's automated redials.
  redialsCancelledOn DateTime?  @db.Date
  owner              User?      @relation("LeadOwner", fields: [ownerId], references: [id])
  ownerId            String?
  /// The last agent who spoke to, texted or left a message for this lead: a call back goes to them first (owner, 5 Nov).
  lastAgentId        String?
  /// Running free-text notes from the agent console's Lead card; each save also writes a NOTE event.
  notes              String?
  /// VIP callers jump the inbound queue by the queue's `vipPriority` (supervisors set it on the lead card).
  vip                Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events         LeadEvent[]
  calls          Call[]
  callbacks      Callback[]
  messages       Message[]
  queueCallbacks QueueCallback[]

  @@unique([listId, phone])
  @@index([tenantId, phone])
  @@index([listId, status, nextDialAt])
  @@index([tenantId, status])
}

enum LeadEventKind {
  POSTED
  IMPORTED
  SCRUBBED
  DIAL
  ANSWERED
  DISPOSITION
  NOTE
  TEXT_IN
  TEXT_OUT
  CALLBACK_SET
  WEBHOOK
  DNC
  BLOCKED
  TRANSFER_STARTED
  TRANSFER_ANSWERED
  TRANSFER_NO_ANSWER
  TRANSFER_CANCELLED
  AGENT_LEFT
}

model LeadEvent {
  id        String        @id @default(cuid())
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  tenantId  String
  lead      Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  kind      LeadEventKind
  actor     User?         @relation(fields: [actorId], references: [id])
  actorId   String?
  data      Json          @default("{}")
  createdAt DateTime      @default(now())

  @@index([leadId, createdAt])
}

model Affiliate {
  id            String   @id @default(cuid())
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  tenantId      String
  name          String
  /// Hashed; the plain key is shown once at creation.
  apiKeyHash    String   @unique
  apiKeyHint    String
  /// Inbound field name -> Strowger field name.
  fieldMapping  Json     @default("{}")
  defaultListId String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  lists List[]
  users User[]

  @@unique([tenantId, name])
}

// ───────────────────────────── Compliance ─────────────────────────────

enum DncScope {
  SYSTEM
  CAMPAIGN
}

enum DncSource {
  MANUAL
  STOP_KEYWORD
  /// The AI read of a free-text reply found a request to stop.
  AI_OPT_OUT
  DISPOSITION
  IMPORT
  CROSSBAR
}

model DncEntry {
  id         String    @id @default(cuid())
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  tenantId   String
  phone      String
  scope      DncScope  @default(SYSTEM)
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String?
  source     DncSource @default(MANUAL)
  note       String?
  createdAt  DateTime  @default(now())

  @@unique([tenantId, phone, campaignId])
  @@index([tenantId, phone])
}

/// Seeded from packages/shared/compliance; not per tenant. `verifiedAt` stays
/// null until counsel has confirmed the row (plan §6).
model StateRule {
  state             String    @id
  startHour         Int
  endHour           Int
  /// Per-day-of-week overrides: {"0": {"startHour":12,"endHour":21}} or
  /// {"0": null} for no calls on Sunday.
  dayOverrides      Json      @default("{}")
  maxAttemptsPerDay Int?
  noHolidayCalls    Boolean   @default(false)
  citation          String?
  verifiedAt        DateTime?
  updatedAt         DateTime  @updatedAt
}

/// Daily answered/abandoned per campaign, the inputs to the rolling 30-day rate.
model AbandonLedger {
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  tenantId   String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  day        DateTime @db.Date
  answered   Int      @default(0)
  abandoned  Int      @default(0)

  @@id([campaignId, day])
  @@index([tenantId, day])
}

// ───────────────────────────── Telephony assets ─────────────────────────────

enum CallerIdStatus {
  ACTIVE
  RESTING
  SPAM_FLAGGED
  RETIRED
}

/// What a carrier's analytics engine says about one of our numbers.
enum CarrierVerdict {
  GOOD
  FLAGGED
  SPAM
  BLOCKED
  UNKNOWN
}

model CallerIdNumber {
  id         String         @id @default(cuid())
  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  tenantId   String
  phone      String
  areaCode   String
  state      String?
  status     CallerIdStatus @default(ACTIVE)
  smsEnabled Boolean        @default(false)
  provider   String         @default("commio")
  lastUsedAt DateTime?
  usedToday  Int            @default(0)
  createdAt  DateTime       @default(now())

  /// Optional: pin a number to one campaign. Null = shared pool.
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  campaignId String?

  /// Where an inbound call to this number goes.
  routeTo     InboundRoute @default(CAMPAIGN)
  ivr         Ivr?         @relation(fields: [ivrId], references: [id])
  ivrId       String?
  queue       Queue?       @relation(fields: [queueId], references: [id])
  queueId     String?
  routeUser   User?        @relation("NumberRouteUser", fields: [routeUserId], references: [id])
  routeUserId String?
  /// Business hours; closed → the schedule's after-hours action (inbound/router.ts).
  schedule    Schedule?    @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  scheduleId  String?
  /// Caller state / area code → queue, checked before `routeTo`.
  geoRoutes   GeoRoute[]

  /// Latest reputation reading per carrier (the Big Three), the STIR/SHAKEN
  /// attestation seen on our outbound calls, and when we last checked.
  attVerdict     CarrierVerdict @default(UNKNOWN)
  verizonVerdict CarrierVerdict @default(UNKNOWN)
  tmobileVerdict CarrierVerdict @default(UNKNOWN)
  attestation    String?
  lastScannedAt  DateTime?
  /// Re-check this number on the daily sweep.
  autoRecheck    Boolean        @default(true)

  /// Hygiene (owner, 4 Nov): registered at the Free Caller Registry before
  /// the first dial; warm-up caps by age; rest after a flag.
  registeredAt    DateTime?
  firstUsedAt     DateTime?
  /// Null = automatic by age: week 1 → 40/day, weeks 2–3 → 65/day, then 75/day.
  dailyCap        Int?
  /// Out of rotation until this time (auto-pull on a spam flag: 3 weeks).
  restUntil       DateTime?
  shortCallsToday Int       @default(0)

  /// Provisioning: ids at the carrier and in jambonz, and how far along the number is.
  /// manual = added by hand; ordered = bought, waiting at Telnyx; voice = in jambonz; ready = voice + messaging profile; failed.
  telnyxNumberId        String?
  jambonzPhoneNumberSid String?
  provisionStatus       String       @default("manual")
  provisionError        String?
  order                 NumberOrder? @relation(fields: [orderId], references: [id])
  orderId               String?

  scans DidScan[]

  @@unique([tenantId, phone])
  @@index([tenantId, areaCode, status])
  @@index([tenantId, lastScannedAt])
}

/// One reputation reading of one number, kept so a change can be dated.
/// One purchase at the carrier: which area code, how many, for which campaign, and what came back.
model NumberOrder {
  id            String           @id @default(cuid())
  tenant        Tenant           @relation(fields: [tenantId], references: [id])
  tenantId      String
  campaign      Campaign?        @relation(fields: [campaignId], references: [id])
  campaignId    String?
  areaCode      String
  quantity      Int
  telnyxOrderId String?
  /// pending | success | failure (Telnyx order status) or error
  status        String           @default("pending")
  error         String?
  requestedBy   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  numbers       CallerIdNumber[]

  @@index([tenantId, createdAt])
}

/// Floor chat. A channel is EVERYONE, MANAGERS (supervisors, room supervisors,
/// team leaders, admins), a TEAM (its members and leader), a CAMPAIGN (its
/// agents and every manager) or a DIRECT message (the two users, key = both
/// ids sorted and joined with ":"). Delivery is by socket to each recipient.
model ChatMessage {
  id        String      @id @default(cuid())
  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  tenantId  String
  channel   ChatChannel
  /// teamId, campaignId, or "a:b" for DIRECT; null for EVERYONE and MANAGERS.
  channelId String?
  sender    User        @relation("ChatSender", fields: [senderId], references: [id])
  senderId  String
  body      String
  createdAt DateTime    @default(now())

  @@index([tenantId, channel, channelId, createdAt])
}

enum ChatChannel {
  EVERYONE
  MANAGERS
  TEAM
  CAMPAIGN
  DIRECT
}

/// Games (owner, 5 Nov). A bet between two agents on a stat, paid in points.
model Wager {
  id         String      @id @default(cuid())
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  tenantId   String
  proposer   User        @relation("WagerProposer", fields: [proposerId], references: [id])
  proposerId String
  accepter   User?       @relation("WagerAccepter", fields: [accepterId], references: [id])
  accepterId String?
  /// The campaign the bet is on (bets are switched on per campaign). Null only on bets from before that.
  campaignId String?
  /// NEXT_SALE, NEXT_CALL, NEXT_CONTACT, MOST_CALLS_TODAY, MOST_CONTACTS_TODAY, MOST_SALES_TODAY, MOST_SALES_WEEK
  kind       String
  stake      Int
  status     WagerStatus @default(OPEN)
  /// For "most … today/week": the period key the bet settles on (YYYY-MM-DD or YYYY-Www).
  period     String?
  winnerId   String?
  note       String?
  createdAt  DateTime    @default(now())
  settledAt  DateTime?

  @@index([tenantId, status, createdAt])
  @@index([tenantId, campaignId, status])
}

enum WagerStatus {
  OPEN
  ACCEPTED
  SETTLED
  DECLINED
  VOID
}

model PointsLedger {
  id        String   @id @default(cuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  delta     Int
  reason    String
  wagerId   String?
  createdAt DateTime @default(now())

  @@index([tenantId, userId, createdAt])
}

/// Poker run: an admin starts one per campaign with a name, a window, a prize
/// and the rule for what deals a card; seven cards at most, the best five when it ends win.
model PokerRun {
  id              String         @id @default(cuid())
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  tenantId        String
  campaign        Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId      String
  name            String
  startsAt        DateTime
  endsAt          DateTime
  /// Display only; paying it is the owner's.
  prize           String?
  /// SALE | CONTACT | CODES (see shared/games POKER_QUALIFIERS).
  qualifies       String         @default("SALE")
  /// Disposition codes that deal a card when qualifies = CODES.
  qualifyingCodes String[]       @default([])
  /// Seven-card stud (owner, 6 Nov): a card each time the agent's qualifying outcomes in the run reach the next multiple of this.
  outcomesPerCard Int            @default(1)
  status          PokerRunStatus @default(ACTIVE)
  createdBy       User           @relation("PokerRunCreator", fields: [createdById], references: [id])
  createdById     String
  /// Set when the run ends: the best hand and who held it.
  winnerId        String?
  /// {"userId","name","hand","cards":[…]} for the winner; null when nobody had a card.
  winningHand     Json?
  endedAt         DateTime?
  createdAt       DateTime       @default(now())

  cards PokerCard[]

  @@index([tenantId, campaignId, status])
}

enum PokerRunStatus {
  ACTIVE
  ENDED
}

/// A card dealt in a poker run (one per qualifying outcome).
model PokerCard {
  id       String    @id @default(cuid())
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  tenantId String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  /// The run the card belongs to. Null only on cards from before explicit runs.
  run      PokerRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId    String?
  /// Legacy period key (YYYY-MM-DD or YYYY-Www) from before runs; the ISO week the card was dealt in since.
  period   String
  /// e.g. "AS", "TD", "9H", "2C"
  card     String
  callId   String?
  dealtAt  DateTime  @default(now())

  @@index([tenantId, period, userId])
  @@index([runId, userId])
}

/// Billing (owner, 5 Nov): prepaid per client. A seat is an agent who logs in
/// during the month; admins and managers are free. Minutes, DIDs (cost + 50%),
/// scrub records (cost + margin) and texts are charged as they happen. Prices
/// are in millicents (1/1000 of a cent) so 1.2¢/min is 1200.
model BillingAccount {
  id                              String    @id @default(cuid())
  tenant                          Tenant    @relation(fields: [tenantId], references: [id])
  tenantId                        String    @unique
  balanceCents                    Int       @default(0)
  seatMonthlyCents                Int       @default(7000)
  perMinuteMillicents             Int       @default(1200)
  /// Markup on the DID monthly cost, percent (50 = cost + 50%).
  didMarkupPct                    Int       @default(50)
  /// Added on top of our scrub cost, per record.
  scrubMarginMillicents           Int       @default(500)
  /// Per text segment sent, price to the client.
  smsPriceMillicents              Int       @default(1500)
  /// Per minute the AI answer is on a call, price to the client; 0 = not charged (owner sets it).
  aiMinutePriceMillicents         Int       @default(0)
  transcriptMinutePriceMillicents Int       @default(0)
  assistCallPriceMillicents       Int       @default(0)
  /// Warn below this balance.
  lowBalanceCents                 Int       @default(20000)
  /// Days the balance may sit at or below zero before outbound is paused.
  graceDays                       Int       @default(3)
  suspended                       Boolean   @default(false)
  suspendedAt                     DateTime?
  /// BALANCE (used up past grace) or TRIAL_ENDED (free trial over, never paid).
  suspendReason                   String?
  zeroSince                       DateTime?
  notes                           String?
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt
}

enum BillingKind {
  CHARGE
  PAYMENT
  ADJUSTMENT
  /// The free trial's usage allowance (positive), and its removal at trial end (negative). Never money.
  TRIAL_CREDIT
  /// Commission on a referred client's paid usage, as account credit. Never cash.
  REFERRAL_CREDIT
  /// A refund on the referred account taking back earlier referral credit (negative).
  REFERRAL_CLAWBACK
}

enum BillingCategory {
  SEAT
  MINUTES
  DID
  SCRUB
  SMS
  OTHER
  PAYMENT
  /// AI answer minutes on inbound queues.
  AI
  TRIAL
  REFERRAL
}

/// The ledger. Charges are negative amounts; payments positive. costCents is what we paid, for margin.
model BillingEntry {
  id             String          @id @default(cuid())
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  tenantId       String
  kind           BillingKind
  category       BillingCategory
  quantity       Decimal         @default(1) @db.Decimal(14, 4)
  unitMillicents Int             @default(0)
  amountCents    Int
  costCents      Int             @default(0)
  /// rate = computed from PlatformRates; telnyx = replaced by the carrier's actual charge.
  costSource     String          @default("rate")
  note           String?
  refId          String?
  /// YYYY-MM the charge belongs to.
  period         String
  createdById    String?
  /// Idempotency for entries a job posts (referral credits: ref:<referralId>:<period>:credit).
  uniqueKey      String?         @unique
  createdAt      DateTime        @default(now())

  @@index([tenantId, period, category])
  @@index([tenantId, createdAt])
}

/// Platform-wide cost rates (what we pay), one row. Edited on /platform.
model PlatformRates {
  id                        String    @id @default("default")
  telnyxOutMillicentsPerMin Int       @default(500)
  telnyxInMillicentsPerMin  Int       @default(320)
  didMonthlyCents           Int       @default(110)
  scrubCostMillicents       Int       @default(500)
  smsCostMillicents         Int       @default(400)
  /// What an AI-answer minute costs us in speech (jambonz STT + TTS), recorded as vendor usage; the LLM is costed from tokens.
  aiMinuteCostMillicents    Int       @default(0)
  sttMinuteCostMillicents   Int       @default(0)
  /// Shown to clients on their billing page: how to prepay.
  prepayInstructions        String?
  /// Last Telnyx account balance seen (GET /v2/balance) and when.
  telnyxBalanceCents        Int?
  telnyxBalanceAt           DateTime?
  telnyxSyncedAt            DateTime?
  /// Shared costs (fixed monthly with no client, and unmatched vendor usage) are split across clients by this: MINUTES | SEATS.
  costAllocation            String    @default("MINUTES")
  /// Also spread vendor usage that matched no client (AMD, conference legs, unmatched records) by the same rule.
  allocateUnattributed      Boolean   @default(true)
  /// A client whose margin % is under this shows red on /platform.
  marginFloorPct            Int       @default(40)
  /// Text to speech (Cartesia through jambonz) per 1,000 characters spoken, our cost.
  ttsCostMillicentsPerKChar Int       @default(4000)
  /// Referral commission, percent of the referred client's paid usage (owner, 6 Nov: 5%).
  referralPct               Decimal   @default(5.00) @db.Decimal(5, 2)
  trialDays                 Int       @default(7)
  trialSeats                Int       @default(5)
  trialAllowanceCents       Int       @default(5000)
  trialMaxNumbers           Int       @default(3)
  /// Offer the trial to sign-ups that did not come through a referral link.
  trialWithoutReferral      Boolean   @default(false)
  updatedAt                 DateTime  @updatedAt
}

/// One client referred another (single tier: never second level). tenantId is the referrer,
/// who owns the row and earns the credit; the referred client appears once.
model Referral {
  id               String           @id @default(cuid())
  tenant           Tenant           @relation("referrer", fields: [tenantId], references: [id])
  tenantId         String
  referred         Tenant           @relation("referred", fields: [referredTenantId], references: [id])
  referredTenantId String           @unique
  /// link (sign-up through /r/<code>) or platform (attribution set by a platform admin).
  source           String           @default("link")
  code             String?
  createdAt        DateTime         @default(now())
  /// The referred client's first payment: attribution can no longer change.
  lockedAt         DateTime?
  endedAt          DateTime?
  endedReason      String?
  payouts          ReferralPayout[]

  @@index([tenantId])
}

/// The month run's result per relationship: a credit, or a forfeited month with its reason (zero, not banked), and any clawback.
model ReferralPayout {
  id                String   @id @default(cuid())
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  /// The referrer.
  tenantId          String
  referral          Referral @relation(fields: [referralId], references: [id])
  referralId        String
  referredTenantId  String
  /// YYYY-MM the commission is for (the month before the run).
  period            String
  /// CREDIT | FORFEITED
  status            String
  pct               Decimal  @db.Decimal(5, 2)
  baseCents         Int
  creditCents       Int
  reason            String?
  clawbackBaseCents Int      @default(0)
  clawbackCents     Int      @default(0)
  createdById       String?
  createdAt         DateTime @default(now())

  @@unique([referralId, period])
  @@index([tenantId, period])
}

/// Every trial started, kept even if the workspace goes: one trial per business (email key or phone).
model TrialClaim {
  id          String   @id @default(cuid())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  tenantId    String
  businessKey String
  phone       String
  email       String
  createdAt   DateTime @default(now())

  @@index([businessKey])
  @@index([phone])
}

/// What vendors charge us, as pulled from their APIs or computed from token usage. One row per record (call, message, AI request) or per day for aggregates.
model VendorUsage {
  id             String   @id @default(cuid())
  tenantId       String?
  vendor         String
  /// sip-trunking, messaging, amd, conference, ai.classify, ai.assist, …
  kind           String
  quantity       Decimal  @default(1) @db.Decimal(14, 4)
  /// Rounded to the cent for old readers; costMillicents is the figure every total uses.
  costCents      Int
  /// What we paid in thousandths of a cent, so a fraction-of-a-cent AI request is not lost.
  costMillicents Int      @default(0)
  /// api = pulled from the vendor's records; usage = counted per event (tokens, minutes, characters) × a list price or rate;
  /// estimate = our rate until the vendor's record is matched (replaced then); fixed = a monthly cost entered on /platform.
  source         String   @default("usage")
  day            String
  /// Telnyx record id, or our own key for rows we write (est:call:<id>, did:<numberId>:<YYYY-MM>, fixed:<id>:<YYYY-MM>).
  vendorRecordId String?
  refId          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([vendor, vendorRecordId])
  @@index([vendor, day])
  @@index([tenantId, day])
}

model DidScan {
  id             String         @id @default(cuid())
  number         CallerIdNumber @relation(fields: [numberId], references: [id], onDelete: Cascade)
  numberId       String
  vendor         String
  attVerdict     CarrierVerdict @default(UNKNOWN)
  verizonVerdict CarrierVerdict @default(UNKNOWN)
  tmobileVerdict CarrierVerdict @default(UNKNOWN)
  attestation    String?
  raw            Json?
  createdAt      DateTime       @default(now())

  @@index([numberId, createdAt])
}

enum InboundRoute {
  CAMPAIGN
  IVR
  QUEUE
  USER
}

/// Something an agent can do: a language, a product line, a support tier.
model Skill {
  id       String       @id @default(cuid())
  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  tenantId String
  name     String
  agents   AgentSkill[]

  @@unique([tenantId, name])
}

model AgentSkill {
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId String
  /// 1 (basic) to 5 (expert).
  level   Int    @default(3)

  @@id([userId, skillId])
}

/// A menu: greeting, digit options, optional extension dialing.
model Ivr {
  id              String           @id @default(cuid())
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  tenantId        String
  name            String
  greetingAudioId String?
  /// [{ "digit": "1", "label": "Sales", "action": "QUEUE"|"USER"|"VOICEMAIL"|"IVR"|"HANGUP", "targetId": "…" }]
  options         Json             @default("[]")
  /// Callers may dial an agent's extension at any time.
  allowExtensions Boolean          @default(true)
  /// What happens on no input after `timeoutSeconds` and `repeats` replays.
  timeoutSeconds  Int              @default(6)
  repeats         Int              @default(2)
  timeoutAction   String           @default("HANGUP")
  timeoutTargetId String?
  numbers         CallerIdNumber[]
  /// Used by a GEO option: caller state / area code → queue.
  geoRoutes       GeoRoute[]

  @@unique([tenantId, name])
}

/// Callers wait here for an agent with the right skills.
model Queue {
  id              String           @id @default(cuid())
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  tenantId        String
  name            String
  /// [{ "skillId": "…", "minLevel": 3 }] — all required.
  requiredSkills  Json             @default("[]")
  /// Campaign whose agents are preferred and whose context the call carries.
  campaign        Campaign?        @relation(fields: [campaignId], references: [id])
  campaignId      String?
  holdAudioId     String?
  maxWaitSeconds  Int              @default(300)
  /// VOICEMAIL | QUEUE | HANGUP
  overflowAction  String           @default("VOICEMAIL")
  overflowQueueId String?
  voicemailBox    VoicemailBox?    @relation(fields: [voicemailBoxId], references: [id])
  voicemailBoxId  String?
  numbers         CallerIdNumber[]

  /// Business hours; closed → the schedule's after-hours action.
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  scheduleId String?

  // Distribution (shared/inbound/distribution.ts)
  strategy          QueueStrategy @default(LONGEST_IDLE)
  /// Priority: base + VIP lead + known lead + 1 point per `agingSeconds` waited (0 = no aging). Higher is served first.
  priority          Int           @default(0)
  vipPriority       Int           @default(10)
  knownLeadPriority Int           @default(2)
  agingSeconds      Int           @default(60)
  /// Offer a returning caller to the agent who last handled their lead for this long first; 0 = off.
  stickySeconds     Int           @default(20)
  /// Forced hold: no agent is offered the caller until they have waited this long (counted from their first queue); 0 = off.
  minHoldSeconds    Int           @default(0)
  /// VIP leads skip the forced hold.
  minHoldBypassVip  Boolean       @default(true)

  // Announcements (text to speech `say` between hold music)
  announce             Boolean @default(false)
  announceEverySeconds Int     @default(60)
  announcePosition     Boolean @default(true)
  announceWait         Boolean @default(true)

  // Virtual hold: "press 1 to get a call back without losing your place"
  callbackEnabled           Boolean @default(false)
  callbackOfferAfterSeconds Int     @default(90)
  /// Optional recorded offer; otherwise the offer is spoken.
  callbackAudioId           String?

  // Blending: the ratio pacer leaves the queue's agents alone
  /// Past this wait for the oldest caller, no new outbound calls for the queue's agents; 0 = never.
  blendWaitSeconds Int @default(30)
  /// Qualified agents always kept out of outbound while the queue is open.
  reserveAgents    Int @default(0)

  // Limits and wrap-up
  /// Callers waiting at most; 0 = no limit. A caller past it gets `fullAction`.
  maxWaiting    Int    @default(0)
  /// VOICEMAIL | QUEUE (the overflow queue) | HANGUP
  fullAction    String @default("VOICEMAIL")
  /// After an inbound call from this queue the agent is in WRAP_UP this long, then back to Ready (unless they paused); 0 = until the disposition.
  wrapUpSeconds Int    @default(30)
  /// Service level target: answered within this many seconds.
  slaSeconds    Int    @default(20)

  // Post-call survey (press 1 to 5 after the agent hangs up)
  surveyEnabled Boolean @default(false)
  surveyAudioId String?

  // AI answer (shared/inbound/ai.ts; engine inbound/ai). Off until the jambonz account has speech-to-text.
  aiEnabled        Boolean     @default(false)
  aiMode           QueueAiMode @default(FIRST)
  /// OVERFLOW: the AI takes a caller who has waited this long with no agent free; 0 = at once.
  aiAfterSeconds   Int         @default(60)
  aiGreeting       String?
  /// The client's system prompt: who the assistant is, the business, the tone. Fixed safety rules go ahead of it.
  aiInstructions   String?
  /// FAQ text the client pastes; kept in the prompt, capped (AI_KNOWLEDGE_MAX).
  aiKnowledge      String?
  /// Said by the caller = straight to a person, matched on the transcript before the LLM.
  aiHandoffPhrases String[]    @default(["operator", "manager", "supervisor", "human", "agent", "representative", "real person", "speak to someone"])
  /// Then hand off to a person.
  aiMaxMinutes     Int         @default(10)
  /// jambonz speech vendors; null = the account's (deepgram first for speech-to-text, cartesia first for speech).
  aiSttVendor      String?
  aiTtsVendor      String?
  aiVoice          String?
  aiLanguage       String      @default("en-US")
  aiLlmVendor      String      @default("anthropic")
  aiModel          String      @default("claude-sonnet-5-5")

  /// Live transcription and agent assist on calls this queue hands to an agent (the rest follows the queue's campaign).
  transcriptionOn Boolean @default(false)
  liveAssistOn    Boolean @default(false)

  calls      Call[]
  callbacks  QueueCallback[]
  geoTargets GeoRoute[]      @relation("GeoTarget")

  @@unique([tenantId, name])
}

enum QueueAiMode {
  /// The AI answers every call before the queue.
  FIRST
  /// The AI answers only when no agent is free, the queue is closed, or the wait passes aiAfterSeconds.
  OVERFLOW
  /// The AI handles everything; a person only when the caller asks.
  ONLY
}

enum AiOutcome {
  RESOLVED
  HANDOFF
  MESSAGE
  CALLBACK
  HANGUP
}

enum QueueStrategy {
  LONGEST_IDLE
  ROUND_ROBIN
  FEWEST_CALLS
  MOST_SKILLED
}

/// Business hours for queues and numbers (shared/inbound/schedule.ts evaluates it).
model Schedule {
  id                    String           @id @default(cuid())
  tenant                Tenant           @relation(fields: [tenantId], references: [id])
  tenantId              String
  name                  String
  timezone              String           @default("America/New_York")
  /// {"1": [["09:00","17:00"]], …} keyed by weekday, Sunday = "0"; a range ending at or before its start runs overnight.
  weekly                Json             @default("{}")
  /// [{ "date": "2026-12-25", "name": "Christmas", "audioId": "…" }]
  holidays              Json             @default("[]")
  /// Manual "closed now": until `closedUntil` (null = until switched off), with its own message.
  closedNow             Boolean          @default(false)
  closedUntil           DateTime?
  closedNowAudioId      String?
  /// Closed → VOICEMAIL (box) | IVR | QUEUE | MESSAGE (greeting, then hang up)
  closedAction          String           @default("MESSAGE")
  closedTargetId        String?
  /// Played first when closed (any action); a holiday or override message replaces it.
  closedGreetingAudioId String?
  queues                Queue[]
  numbers               CallerIdNumber[]
  createdAt             DateTime         @default(now())

  @@unique([tenantId, name])
}

/// Geographic routing: on a number (checked before its route) or an IVR (its GEO option).
model GeoRoute {
  id            String          @id @default(cuid())
  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  tenantId      String
  name          String
  number        CallerIdNumber? @relation(fields: [numberId], references: [id], onDelete: Cascade)
  numberId      String?
  ivr           Ivr?            @relation(fields: [ivrId], references: [id], onDelete: Cascade)
  ivrId         String?
  states        String[]        @default([])
  areaCodes     String[]        @default([])
  targetQueue   Queue           @relation("GeoTarget", fields: [targetQueueId], references: [id], onDelete: Cascade)
  targetQueueId String
  /// Catches every caller no other rule matched.
  isFallback    Boolean         @default(false)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())

  @@index([tenantId])
  @@index([numberId])
  @@index([ivrId])
}

enum QueueCallbackStatus {
  WAITING
  DIALING
  DONE
  FAILED
}

/// Virtual hold: a caller who pressed 1 keeps their place (`score`) and is called back when it is their turn.
model QueueCallback {
  id             String              @id @default(cuid())
  tenant         Tenant              @relation(fields: [tenantId], references: [id])
  tenantId       String
  queue          Queue               @relation(fields: [queueId], references: [id], onDelete: Cascade)
  queueId        String
  phone          String
  lead           Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId         String?
  /// The number they called: the callback shows it.
  callerId       String
  originalCallId String?
  requestedAt    DateTime            @default(now())
  /// Their sorted-set score in the queue when they asked (priority then arrival).
  score          Float
  priority       Int                 @default(0)
  status         QueueCallbackStatus @default(WAITING)
  attempts       Int                 @default(0)
  lastAttemptAt  DateTime?
  agentId        String?
  /// The latest outbound attempt.
  callId         String?
  doneAt         DateTime?

  @@index([queueId, status])
  @@index([tenantId, requestedAt])
}

model VoicemailBox {
  id              String      @id @default(cuid())
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  tenantId        String
  name            String
  owner           User?       @relation("BoxOwner", fields: [ownerId], references: [id])
  ownerId         String?
  greetingAudioId String?
  notifyEmail     String?
  queues          Queue[]
  messages        Voicemail[]

  @@unique([tenantId, name])
}

enum VoicemailStatus {
  NEW
  LISTENED
  DONE
}

model Voicemail {
  id           String          @id @default(cuid())
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  tenantId     String
  box          VoicemailBox    @relation(fields: [boxId], references: [id], onDelete: Cascade)
  boxId        String
  callId       String?
  fromPhone    String
  durationSec  Int?
  recordingUrl String?
  transcript   String?
  status       VoicemailStatus @default(NEW)
  assignee     User?           @relation("VoicemailAssignee", fields: [assigneeId], references: [id])
  assigneeId   String?
  createdAt    DateTime        @default(now())

  @@index([tenantId, status, createdAt])
  @@index([boxId, createdAt])
}

enum AudioKind {
  SAFE_HARBOR
  VOICEMAIL_DROP
  SCREENER_MESSAGE
  DISCLOSURE
  HOLD
  IVR_GREETING
  VM_GREETING
  OTHER
}

model AudioAsset {
  id         String    @id @default(cuid())
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  tenantId   String
  kind       AudioKind
  name       String
  storageUrl String
  createdAt  DateTime  @default(now())
}

// ───────────────────────────── Calls & activity ─────────────────────────────

enum CallDirection {
  OUTBOUND
  INBOUND
  MANUAL
  /// The destination leg of an external transfer (dialer/transfers.ts); billed like outbound.
  TRANSFER
}

enum AmdResult {
  HUMAN
  MACHINE
  SCREENER
  UNKNOWN
}

enum CallOutcome {
  BRIDGED
  VOICEMAIL
  VOICEMAIL_DROPPED
  SCREENER_MESSAGE
  SCREENER_AGENT
  SCREENER_HANGUP
  ABANDONED
  NO_ANSWER
  BUSY
  FAILED
  CANCELLED
}

model Call {
  id             String        @id @default(cuid())
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  tenantId       String
  campaign       Campaign?     @relation(fields: [campaignId], references: [id])
  campaignId     String?
  lead           Lead?         @relation(fields: [leadId], references: [id])
  leadId         String?
  agent          User?         @relation(fields: [agentId], references: [id])
  agentId        String?
  direction      CallDirection
  phone          String
  callerId       String?
  providerCallId String?       @unique

  dialedAt        DateTime  @default(now())
  ringingAt       DateTime?
  answeredAt      DateTime?
  bridgedAt       DateTime?
  endedAt         DateTime?
  /// What the carrier actually charged for this call (from Telnyx detail records), and its record id.
  vendorCostCents Int?
  vendorRecordId  String?

  amdResult        AmdResult?
  screenerDetected Boolean      @default(false)
  outcome          CallOutcome?
  abandoned        Boolean      @default(false)
  disposition      Disposition? @relation(fields: [dispositionId], references: [id])
  dispositionId    String?
  notes            String?

  recordingUrl        String?
  recordingExpiresAt  DateTime?
  /// Where the nightly export put it (sftp://host/path or dropbox:/path).
  recordingExportedTo String?
  recordingDeletedAt  DateTime?
  legalHold           Boolean   @default(false)
  costCents           Int?
  /// Raw provider facts worth keeping (final SIP status, AMD events).
  providerData        Json      @default("{}")

  /// External transfer destination legs hang off the lead's call.
  parent        Call?                @relation("CallLegs", fields: [parentCallId], references: [id])
  parentCallId  String?
  legs          Call[]               @relation("CallLegs")
  destination   TransferDestination? @relation(fields: [destinationId], references: [id])
  destinationId String?

  transfers Transfer[]

  /// Inbound queue facts for the ACD metrics (shared/inbound/metrics.ts).
  queue                 Queue?    @relation(fields: [queueId], references: [id], onDelete: SetNull)
  queueId               String?
  queuedAt              DateTime?
  /// Seconds in the queue before an agent took it, or before the caller hung up.
  waitSeconds           Int?
  abandonedInQueue      Boolean   @default(false)
  /// The queue's forced hold this caller was given, seconds (null = none); the SLA is measured after it.
  forcedHoldSeconds     Int?
  /// Hung up before the forced hold ended (inside abandonedInQueue too).
  abandonedInForcedHold Boolean   @default(false)

  /// AI answer (inbound/ai): when it took the call, when it let go, how it ended, what was said.
  aiHandledAt     DateTime?
  aiEndedAt       DateTime?
  aiOutcome       AiOutcome?
  aiSeconds       Int?
  /// The summary the agent's screen pop shows on a hand-off.
  aiSummary       String?
  /// [{ role: "caller" | "ai", text, at }]
  aiTranscript    Json?
  /// The agent's wrap-up ended (disposition or the queue's wrap-up timer).
  wrapEndedAt     DateTime?
  /// The agent left and the caller went to the post-call survey; talk ends here.
  surveyStartedAt DateTime?
  /// 1 to 5 from the post-call survey.
  surveyScore     Int?

  /// Live transcription: finals [{speaker: CUSTOMER | AGENT, text, at}], capped (shared/assist/live.ts).
  transcript           Json?
  /// Compliance alerts raised on the live transcript [{rule, severity, message, phrase?, text?, at}].
  complianceAlerts     Json?
  /// After the call: {dispositionId, code, label, reason} suggested in wrap-up (the agent confirms).
  suggestedDisposition Json?
  assistCalls          Int   @default(0)
  sttLeadSeconds       Int?
  sttAgentSeconds      Int?

  @@index([tenantId, dialedAt])
  @@index([queueId, queuedAt])
  @@index([campaignId, dialedAt])
  @@index([leadId, dialedAt])
  @@index([agentId, dialedAt])
}

enum TransferKind {
  WARM
  COLD
}

/// External transfer outcome (null while ringing or connected).
enum TransferOutcome {
  ANSWERED
  NO_ANSWER
  CANCELLED
  FAILED
}

/// What the destination sees as the caller: the lead's own number, or a fixed number of ours.
enum TransferCallerIdMode {
  CUSTOMER
  STATIC
}

/// A phone number a campaign's agents can transfer a live lead to (owner, 5 Nov).
model TransferDestination {
  id             String               @id @default(cuid())
  tenant         Tenant               @relation(fields: [tenantId], references: [id])
  tenantId       String
  campaign       Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId     String
  name           String
  /// E.164.
  phone          String
  /// Default for the console's cold/warm toggle. `kind` on Transfer records what was used.
  type           TransferKind         @default(COLD)
  callerIdMode   TransferCallerIdMode @default(CUSTOMER)
  /// One of the workspace's numbers (CallerIdNumber.phone, ten digits) when callerIdMode is STATIC.
  staticCallerId String?
  whisperOn      Boolean              @default(true)
  /// Template with {{company}}, {{campaign}}, {{lead.firstName}}, {{lead.lastName}} and the script variables; null = the default.
  whisperText    String?
  sortOrder      Int                  @default(0)
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  transfers Transfer[]
  calls     Call[]

  @@index([campaignId, sortOrder])
}

model Transfer {
  id          String       @id @default(cuid())
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  tenantId    String
  call        Call         @relation(fields: [callId], references: [id], onDelete: Cascade)
  callId      String
  fromAgent   User         @relation("TransferFrom", fields: [fromAgentId], references: [id])
  fromAgentId String
  toAgent     User?        @relation("TransferTo", fields: [toAgentId], references: [id])
  toAgentId   String?
  /// WARM = three-way until the agent leaves; COLD = agent dropped on answer. For external transfers this is the mode used.
  kind        TransferKind @default(WARM)
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  // External transfers (dialer/transfers.ts).
  destination       TransferDestination? @relation(fields: [destinationId], references: [id])
  destinationId     String?
  /// The Call row of the destination leg (direction TRANSFER).
  destinationCallId String?
  /// Ten-digit number the destination saw; null when no external leg.
  callerIdShown     String?
  /// Telnyx refused the lead's number as `from`; the campaign's caller ID was used instead.
  callerIdFallback  Boolean              @default(false)
  answeredAt        DateTime?
  agentLeftAt       DateTime?
  endedAt           DateTime?
  outcome           TransferOutcome?

  @@index([callId])
}

enum CallbackScope {
  AGENT
  CAMPAIGN
}

enum CallbackStatus {
  SCHEDULED
  OFFERED
  DONE
  MISSED
  CANCELLED
}

model Callback {
  id         String         @id @default(cuid())
  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  tenantId   String
  campaign   Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  lead       Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId     String
  agent      User?          @relation(fields: [agentId], references: [id])
  agentId    String?
  scope      CallbackScope  @default(AGENT)
  dueAt      DateTime
  status     CallbackStatus @default(SCHEDULED)
  note       String?
  createdAt  DateTime       @default(now())

  @@index([campaignId, status, dueAt])
  @@index([agentId, status, dueAt])
}

enum AgentState {
  LOGGED_IN
  READY
  RESERVED
  ON_CALL
  WRAP_UP
  PAUSED
  LOGGED_OUT
}

/// One row per agent login, with a running log of state changes in `events`
/// for productivity reporting. Live state itself lives in Redis.
model AgentSession {
  id         String     @id @default(cuid())
  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  tenantId   String
  user       User       @relation(fields: [userId], references: [id])
  userId     String
  campaign   Campaign?  @relation(fields: [campaignId], references: [id])
  campaignId String?
  startedAt  DateTime   @default(now())
  endedAt    DateTime?
  lastState  AgentState @default(LOGGED_IN)
  events     Json       @default("[]")

  @@index([tenantId, startedAt])
  @@index([userId, startedAt])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  RECEIVED
}

model Message {
  id                String           @id @default(cuid())
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  tenantId          String
  campaign          Campaign?        @relation(fields: [campaignId], references: [id])
  campaignId        String?
  lead              Lead?            @relation(fields: [leadId], references: [id])
  leadId            String?
  agent             User?            @relation(fields: [agentId], references: [id])
  agentId           String?
  direction         MessageDirection
  fromPhone         String
  toPhone           String
  body              String
  provider          String           @default("commio")
  providerMessageId String?          @unique
  status            MessageStatus    @default(QUEUED)
  /// Which automated touch sent it: pre_call, missed_call, or null for manual.
  purpose           String?
  error             String?
  /// AI read of an inbound reply: OPT_OUT, CALLBACK_REQUEST, QUESTION, WRONG_NUMBER, INTERESTED, NOT_INTERESTED, OTHER. Null = keyword matched or AI not configured.
  intent            String?
  intentConfidence  Float?
  intentReason      String?
  vendorCostCents   Int?
  createdAt         DateTime         @default(now())

  @@index([leadId, createdAt])
  @@index([tenantId, createdAt])
}

// ───────────────────────────── Integration & audit ─────────────────────────────

model WebhookEndpoint {
  id         String    @id @default(cuid())
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  tenantId   String
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String?
  url        String
  secret     String
  /// Event names, e.g. ["disposition", "sale", "callback"].
  events     String[]
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  deliveries WebhookDelivery[]
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

model WebhookDelivery {
  id          String          @id @default(cuid())
  endpoint    WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  endpointId  String
  event       String
  payload     Json
  status      DeliveryStatus  @default(PENDING)
  attempts    Int             @default(0)
  lastError   String?
  createdAt   DateTime        @default(now())
  deliveredAt DateTime?

  @@index([endpointId, status, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  String
  actor     User?    @relation(fields: [actorId], references: [id])
  actorId   String?
  action    String
  target    String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

/// A cost with no usable API (Railway, Clerk, the jambonz.cloud plan, a scrub subscription, 10DLC fees), entered on /platform.
/// Written into VendorUsage once per month it covers (source "fixed"); with a tenant it is that client's, else shared.
model VendorFixedCost {
  id           String   @id @default(cuid())
  /// The client this belongs to; null = shared, allocated across clients by PlatformRates.costAllocation.
  tenantId     String?
  vendor       String
  /// subscription, hosting, auth, 10dlc, …
  kind         String   @default("subscription")
  label        String
  amountCents  Int
  /// MONTHLY (every month from startPeriod to endPeriod) | ONCE (startPeriod only).
  cadence      String   @default("MONTHLY")
  startPeriod  String
  endPeriod    String?
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([vendor])
}

/// A vendor account: its balance (from the API where there is one, else entered), when it was read, and the warning line.
model VendorAccount {
  vendor          String    @id
  balanceCents    Int?
  /// api | manual
  balanceSource   String?
  balanceAt       DateTime?
  lowBalanceCents Int?
  usageSyncedAt   DateTime?
  /// What the vendor's own report says for the current month (Anthropic cost report, jambonz upcoming invoice), for reconciliation.
  reportedPeriod  String?
  reportedCents   Int?
  reportedAt      DateTime?
  lastError       String?
  lastErrorAt     DateTime?
  note            String?
  updatedAt       DateTime  @updatedAt
}
